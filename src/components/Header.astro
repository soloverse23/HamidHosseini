---
// Wide screens, two tiers:
//  1. A thin bar with the language switch and the theme toggle.
//  2. The nameplate (logo mark) and the numbered section index, like a book's contents.
// Narrow screens, one bar: logo, search and a hamburger that opens the same
// index as a sheet, with language and theme at its foot.
import { LOCALES, LOCALE_META, type Locale } from '../i18n/locales';
import { t } from '../i18n/strings';
import { ui } from '../i18n/ui';
import { questionsIn } from '../lib/content';
import { num } from '../lib/format';
import { href } from '../lib/paths';
import Icon from './Icon.astro';
import Mark from './Mark.astro';

interface Props {
  locale: Locale;
  /** Current path without the locale prefix, used for the language switch */
  path: string;
  /** Locales this page exists in; the others switch to their home page */
  locales?: readonly Locale[];
}
const { locale, path, locales = LOCALES } = Astro.props;
const switchHref = (l: Locale) => (locales.includes(l) ? href(l, path) : href(l));
const s = t(locale);
const u = ui(locale);
const section = path.split('/')[0];
// Each language's name in the reader's current language, e.g. "Persian" / "فارسی".
const gloss = new Intl.DisplayNames([LOCALE_META[locale].intl.split('-u-')[0]], { type: 'language' });
const pad = (i: number) => num(locale, i).padStart(2, locale === 'fa' ? '۰' : locale === 'ar' ? '٠' : '0');

// Organised by what readers look for, not by platform: the platforms are
// filters inside "Latest" and "Shorts". `match` lists the sections each item
// stands for, for the current-page mark.
const NAV = [
  { key: 'quran', path: 'quran', match: ['quran'] },
  { key: 'topics', path: 'topics', match: ['topics'] },
  { key: 'series', path: 'videos', match: ['videos'] },
  { key: 'library', path: 'writings', match: ['writings', 'articles'] },
  { key: 'shorts', path: 'shorts', match: ['shorts', 'tiktok', 'instagram'] },
  // Questions and answers appear once the reader's language has some.
  ...(questionsIn(locale).length ? [{ key: 'qa', path: 'qa', match: ['qa'] } as const] : []),
  { key: 'latest', path: '#latest', match: ['notes'] },
  { key: 'about', path: 'about', match: ['about'] },
] as const;
const navHref = (path: string) => (path.startsWith('#') ? `${href(locale)}${path}` : href(locale, path));
---

<header class="site-header">
  <div class="topbar">
    <div class="wrap topbar__inner">
      <div class="topbar__end">
        <details class="lang">
          <summary class="lang__btn" aria-label={`${u.language}: ${LOCALE_META[locale].label}`}>
            <Icon name="globe" />
            <span class="lang__current">{LOCALE_META[locale].label}</span>
            <Icon name="chevron" class="lang__chev" />
          </summary>
          <div class="lang__panel">
            <p class="lang__title">{u.language}</p>
            <ul>
              {
                LOCALES.map((l) => (
                  <li>
                    <a
                      href={switchHref(l)}
                      hreflang={l}
                      aria-current={l === locale ? 'true' : undefined}
                      data-set-locale={l}
                    >
                      <span class="lang__code" aria-hidden="true">{LOCALE_META[l].short}</span>
                      <span class="lang__names">
                        <span class="lang__native" lang={l} dir={LOCALE_META[l].dir}>
                          {LOCALE_META[l].label}
                        </span>
                        {l !== locale && <span class="lang__gloss">{gloss.of(l)}</span>}
                      </span>
                      {l === locale && <Icon name="check" class="lang__check" />}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </details>
        <button class="icon-btn theme-toggle" type="button" aria-label={s.theme.toggle}>
          <Icon name="moon" class="i-moon" />
          <Icon name="sun" class="i-sun" />
        </button>
      </div>
    </div>
  </div>

  <div class="wrap mainbar">
    <a class="plate" href={href(locale)} aria-label={`${s.name}: ${s.tagline}`}>
      <Mark size={34} class="plate__mark" />
      <span class="plate__text">
        <span class="plate__name">{s.name}</span>
        <span class="plate__tag">{s.tagline}</span>
      </span>
    </a>

    <!-- Wide screens: the nav sits inline and the rest is hidden (the menu
         box itself has display: contents). Narrow screens: the whole box is
         the sheet the hamburger opens, with language and theme at its foot. -->
    <div class="menu" id="site-menu">
      <nav class="primary" aria-label={s.contents}>
        <ol>
          {
            NAV.map(({ key, path, match }, i) => (
              <li>
                <a href={navHref(path)} aria-current={(match as readonly string[]).includes(section) ? 'page' : undefined}>
                  <span class="primary__no num" aria-hidden="true">{key === 'about' ? '' : pad(i + 1)}</span>
                  <span class="primary__label">{key === 'qa' ? s.qa.title : s.nav[key]}</span>
                  <Icon name="chevron" class="primary__chev flip" />
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="menu__foot">
        <ul class="menu__langs" aria-label={u.language}>
          {
            LOCALES.map((l) => (
              <li>
                <a
                  href={switchHref(l)}
                  lang={l}
                  dir={LOCALE_META[l].dir}
                  hreflang={l}
                  aria-current={l === locale ? 'true' : undefined}
                  data-set-locale={l}
                >
                  {LOCALE_META[l].label}
                </a>
              </li>
            ))
          }
        </ul>
        <button class="menu__theme theme-toggle" type="button">
          <Icon name="moon" class="i-moon" />
          <Icon name="sun" class="i-sun" />
          <span>{s.theme.toggle}</span>
        </button>
      </div>
    </div>

    <div class="mainbar__actions">
      <a
        class="search-btn"
        href={href(locale, 'search')}
        data-search-open
        aria-label={s.search.label}
        aria-keyshortcuts="Meta+K Control+K /"
        aria-current={section === 'search' ? 'page' : undefined}
      >
        <Icon name="search" />
        <span class="search-btn__text">{s.search.open}</span>
        <span class="search-btn__keys" aria-hidden="true"><span class="kbd" data-mod-key>Ctrl</span><span class="kbd">K</span></span>
      </a>
      <button
        class="icon-btn menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label={u.menu}
      >
        <Icon name="menu" class="i-menu flip" />
        <Icon name="close" class="i-close" />
      </button>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.lang');
  if (menu) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }

  // Narrow screens: the hamburger opens #site-menu as a sheet under the bar
  // (see the max-width: 62rem styles) and the page behind it stops scrolling.
  const menuBtn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const sheet = document.getElementById('site-menu');
  if (menuBtn && sheet) {
    const setOpen = (open: boolean) => {
      menuBtn.setAttribute('aria-expanded', String(open));
      sheet.toggleAttribute('data-open', open);
      document.documentElement.toggleAttribute('data-menu-open', open);
    };
    menuBtn.addEventListener('click', () => setOpen(menuBtn.getAttribute('aria-expanded') !== 'true'));
    sheet.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (
        menuBtn.getAttribute('aria-expanded') === 'true' &&
        !sheet.contains(e.target as Node) &&
        !menuBtn.contains(e.target as Node)
      ) {
        setOpen(false);
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        menuBtn.focus();
      }
    });
    window.matchMedia('(min-width: 62rem)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    background: var(--paper);
    border-block-end: 1px solid var(--rule);
  }

  /* ---------- Tier 1: channel bar ---------- */
  .topbar {
    background: var(--paper-2);
    border-block-end: 1px solid var(--rule);
    font-size: 0.8125rem;
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-4);
    min-height: 2.5rem;
  }
  .topbar__end {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  /* Language menu: a quiet button that opens a small panel. */
  .lang {
    position: relative;
  }
  .lang__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    list-style: none;
    user-select: none;
    line-height: 1.3;
    transition: border-color 0.15s;
  }
  .lang__btn::-webkit-details-marker {
    display: none;
  }
  .lang__btn:hover,
  .lang[open] .lang__btn {
    border-color: var(--ink);
  }
  .lang__btn :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--ink-2);
  }
  .lang__btn :global(.lang__chev) {
    width: 0.75rem;
    height: 0.75rem;
    transform: rotate(90deg);
    transition: transform 0.2s ease;
  }
  .lang[open] .lang__btn :global(.lang__chev) {
    transform: rotate(-90deg);
  }
  .lang__current {
    font-weight: 500;
  }
  :root[dir='rtl'] .lang__current {
    font-family: var(--font-persian);
  }
  .lang__panel {
    position: absolute;
    z-index: 30;
    inset-block-start: calc(100% + 0.5rem);
    inset-inline-end: 0;
    min-width: 15rem;
    padding: var(--space-2);
    background: var(--paper);
    border: 1px solid var(--rule-strong);
    border-radius: 8px;
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.35);
    transform-origin: top var(--end);
    animation: lang-in 0.18s ease-out;
  }
  @keyframes lang-in {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }
  }
  .lang__title {
    padding: var(--space-1) var(--space-2) var(--space-2);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  :root[dir='rtl'] .lang__title {
    letter-spacing: 0;
    font-size: 0.75rem;
  }
  .lang__panel ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .lang__panel a {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2);
    border-radius: 5px;
    text-decoration: none;
    color: var(--ink);
  }
  .lang__panel a:hover {
    background: var(--paper-2);
    color: var(--ink);
  }
  .lang__panel a[aria-current='true'] {
    background: var(--accent-wash);
  }
  .lang__code {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--paper-2);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .lang__panel a[aria-current='true'] .lang__code {
    background: var(--accent);
    color: var(--paper);
  }
  .lang__names {
    display: grid;
    line-height: 1.35;
  }
  .lang__native {
    font-size: 0.9375rem;
    font-weight: 500;
    text-align: var(--start);
  }
  .lang__native[lang='fa'],
  .lang__native[lang='ar'],
  .lang__native[lang='ur'] {
    font-family: var(--font-persian);
  }
  .lang__native[lang='en'],
  .lang__native[lang='ro'] {
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
  }
  .lang__gloss {
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .lang__panel :global(.lang__check) {
    width: 1rem;
    height: 1rem;
    color: var(--accent);
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    background: none;
    color: var(--ink-2);
    cursor: pointer;
    border-radius: var(--radius);
    flex: none;
  }
  .topbar .icon-btn {
    width: 1.9rem;
    height: 1.9rem;
  }
  .icon-btn:hover {
    color: var(--ink);
    background: var(--paper-3);
  }
  .icon-btn :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .theme-toggle :global(.i-sun) {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle :global(.i-sun) {
    display: block;
  }
  :global(:root[data-theme='dark']) .theme-toggle :global(.i-moon) {
    display: none;
  }

  /* ---------- Tier 2: nameplate + contents ---------- */
  .mainbar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'plate nav search';
    align-items: center;
    gap: var(--space-5);
    min-height: 4.75rem;
  }
  .plate {
    grid-area: plate;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--ink);
  }
  .plate:hover {
    color: var(--ink);
  }
  .plate :global(.plate__mark) {
    color: var(--accent);
    flex: none;
    transition: transform 0.4s ease;
  }
  .plate:hover :global(.plate__mark) {
    transform: rotate(45deg);
  }
  .plate__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .plate__name {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.2;
  }
  :root[dir='rtl'] .plate__name {
    font-family: var(--font-persian);
    font-weight: 700;
    line-height: 1.5;
  }
  .plate__tag {
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--ink-3);
  }
  .plate__name,
  .plate__tag {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* On wide screens the menu box is transparent: its nav is a grid item of
     the bar, and the sheet-only parts are hidden. */
  .menu {
    display: contents;
  }
  .menu__foot,
  .primary :global(.primary__chev),
  .primary__no:empty {
    display: none;
  }
  .primary {
    grid-area: nav;
    justify-self: start;
    min-width: 0;
  }
  .primary ol {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
  }
  .primary a {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: var(--space-2) var(--space-3);
    text-decoration: none;
    color: var(--ink-2);
    font-size: 0.9375rem;
    white-space: nowrap;
    border-radius: var(--radius);
  }
  .primary__no {
    font-family: var(--font-serif);
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .primary a:hover {
    color: var(--ink);
    background: var(--paper-2);
  }
  .primary a[aria-current='page'] {
    color: var(--ink);
  }
  .primary a[aria-current='page'] .primary__no {
    color: var(--accent);
  }
  .primary a[aria-current='page']::after {
    content: '';
    position: absolute;
    inset-inline: var(--space-3);
    inset-block-end: -1.05rem;
    height: 2px;
    background: var(--accent);
  }
  .mainbar__actions {
    grid-area: search;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .menu-toggle {
    display: none;
  }
  .menu-toggle :global(.i-close) {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] :global(.i-menu) {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] :global(.i-close) {
    display: block;
  }
  .search-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius);
    color: var(--ink-2);
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .search-btn:hover,
  .search-btn[aria-current='page'] {
    color: var(--ink);
    background: var(--paper-3);
  }
  .search-btn :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
  }
  .search-btn__text,
  .search-btn__keys {
    display: none;
  }
  /* Wide screens: a field-like button that shows the shortcut. */
  @media (min-width: 80rem) {
    .search-btn {
      width: auto;
      min-width: 9.5rem;
      justify-content: flex-start;
      padding-inline: 0.7rem 0.4rem;
      border: 1px solid var(--rule-strong);
      border-radius: 999px;
      background: var(--paper);
      font-size: 0.875rem;
      color: var(--ink-3);
    }
    .search-btn:hover,
    .search-btn[aria-current='page'] {
      border-color: var(--ink);
      background: var(--paper);
    }
    .search-btn__text {
      display: inline;
      margin-inline-end: auto;
    }
    .search-btn__keys {
      display: inline-flex;
      gap: 2px;
    }
  }

  /* Mid-width screens: the full contents row needs the room, so the
     nameplate is the mark alone. */
  @media (max-width: 72rem) {
    .plate__text {
      display: none;
    }
  }

  /* ---------- Narrow screens: one bar and a menu sheet ----------
     Logo at the start edge; search, then the hamburger, at the end edge.
     Every offset is logical (inline-start/end), so the bar and the sheet
     mirror themselves for Persian, Arabic and Urdu. */
  @media (max-width: 62rem) {
    .topbar {
      display: none;
    }
    .mainbar {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'plate search';
      gap: var(--space-3);
      min-height: 3.5rem;
    }
    .plate :global(.plate__mark) {
      width: 30px;
      height: 30px;
    }
    .plate__text {
      display: flex;
    }
    .mainbar__actions {
      gap: var(--space-1);
      /* Line the outermost glyph up with the page gutter, not its hit area. */
      margin-inline-end: calc(-1 * var(--space-2));
    }
    .menu-toggle {
      display: grid;
    }
    .menu-toggle[aria-expanded='true'] {
      color: var(--ink);
      background: var(--paper-3);
    }

    .menu {
      display: none;
      position: absolute;
      z-index: 40;
      inset-inline: 0;
      /* 100% is the header's padding edge: the sheet starts on the bar's
         bottom border and redraws it, then runs to the bottom of the screen. */
      inset-block-start: 100%;
      height: calc(100dvh - 3.5rem);
      border-block-start: 1px solid var(--rule);
      flex-direction: column;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: var(--space-2) var(--gutter) calc(var(--space-6) + env(safe-area-inset-bottom));
      background: var(--paper);
    }
    .menu[data-open] {
      display: flex;
      animation: sheet-in 0.18s ease-out;
    }
    :global(html[data-menu-open]) {
      overflow: hidden;
    }

    .primary {
      justify-self: stretch;
    }
    .primary ol {
      flex-direction: column;
      gap: 0;
    }
    .primary li + li {
      border-block-start: 1px solid var(--rule);
    }
    .primary a {
      display: grid;
      grid-template-columns: 2rem 1fr auto;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-4) 0;
      border-radius: 0;
      font-size: 1.0625rem;
      color: var(--ink);
      white-space: normal;
    }
    .primary a:hover {
      background: none;
      color: var(--accent);
    }
    .primary__no:empty,
    .primary :global(.primary__chev) {
      display: block;
    }
    .primary__no {
      font-size: 0.8125rem;
    }
    .primary :global(.primary__chev) {
      width: 1rem;
      height: 1rem;
      color: var(--ink-3);
    }
    .primary a[aria-current='page'],
    .primary a[aria-current='page'] :global(.primary__chev) {
      color: var(--accent);
    }
    .primary a[aria-current='page']::after {
      content: none;
    }

    .menu__foot {
      display: grid;
      gap: var(--space-4);
      margin-block-start: auto;
      padding-block-start: var(--space-5);
      border-block-start: 1px solid var(--rule-strong);
    }
    /* Equal cells: all five languages on one row on a phone, 3 + 2 on the
       narrowest ones, never one left over on a line of its own. */
    .menu__langs {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space-2) 0.375rem;
      list-style: none;
      padding: 0;
    }
    .menu__langs a {
      display: block;
      padding: 0.4rem 0.25rem;
      border: 1px solid var(--rule-strong);
      border-radius: 999px;
      font-size: 0.875rem;
      line-height: 1.5;
      text-align: center;
      white-space: nowrap;
      text-decoration: none;
      color: var(--ink-2);
    }
    .menu__langs a:hover {
      border-color: var(--ink);
      color: var(--ink);
    }
    .menu__langs a[aria-current='true'] {
      border-color: var(--ink);
      background: var(--ink);
      color: var(--paper);
    }
    .menu__langs a:is([lang='fa'], [lang='ar'], [lang='ur']) {
      font-family: var(--font-persian);
    }
    .menu__langs a:is([lang='en'], [lang='ro']) {
      font-family: 'IBM Plex Sans', system-ui, sans-serif;
    }
    .menu__theme {
      justify-self: start;
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-1) 0;
      border: 0;
