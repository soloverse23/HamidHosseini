---
// Lite YouTube embed: a static poster until play is pressed, then a
// youtube-nocookie iframe. Keeps pages fast and avoids third-party cookies.
import type { Locale } from '../i18n/locales';
import { t } from '../i18n/strings';
import { duration as fmt } from '../lib/format';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  id: string;
  title: string;
  duration?: number;
  vertical?: boolean;
  lang?: string;
}
const { locale, id, title, duration, vertical = false, lang } = Astro.props;
const s = t(locale);
---

<div class:list={['frame', 'yt', vertical ? 'frame--9x16' : 'frame--16x9']} data-yt={id} data-title={title}>
  <img src={`https://i.ytimg.com/vi/${id}/${vertical ? 'hqdefault' : 'hqdefault'}.jpg`} width="480" height="360" alt="" loading="lazy" decoding="async" />
  <button class="play-btn" type="button">
    <span><Icon name="play" /></span>
    <span class="visually-hidden" lang={lang}>{s.videos.play}: {title}</span>
  </button>
  {duration ? <span class="frame__badge">{fmt(duration)}</span> : null}
</div>

<script>
  import { track } from '../lib/analytics';

  document.querySelectorAll<HTMLElement>('.yt').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      track('video_play', { video_id: box.dataset.yt, video_title: box.dataset.title });
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`;
      f.title = box.dataset.title ?? '';
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      f.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';
      box.replaceChildren(f);
    });
  });
</script>
