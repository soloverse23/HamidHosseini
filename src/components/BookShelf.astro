---
// The books on the Writings page: the slider of designed covers up front,
// then the whole shelf, which a reader can search and filter. Books in the
// reader's language come first (originals and translations), then the rest,
// each newest first. Each book shows the edition in the reader's language
// when it has been translated, and the original otherwise, marked with its
// language. Books already opened in the
// reader show how far along the reader is, and come back in "Continue reading".
import { books, editionFor, languageName, shelfFor, type Book } from '../lib/books';
import { LOCALE_META, type Locale } from '../i18n/locales';
import { t } from '../i18n/strings';
import { num, year } from '../lib/format';
import { href } from '../lib/paths';
import { normalize } from '../lib/search/normalize';
import BookCover from './BookCover.astro';
import BookSlider from './BookSlider.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);

/** What this reader sees of a book: its edition, and a gloss of the title when that edition is in another language. */
function view(b: Book) {
  const { edition, missing } = editionFor(b, locale);
  const gloss = edition.lang !== locale ? b.title[locale] : undefined;
  return { edition, missing, gloss };
}
const page = (b: Book) => href(locale, `books/${b.id}`);
const shelf = shelfFor(locale);
const totalPages = books.reduce((n, b) => n + (view(b).edition.pages ?? 0), 0);
const inMine = books.filter((b) => !view(b).missing).length;
---

{
  shelf.length > 0 && (
    <>
    <BookSlider locale={locale} />
    <section aria-labelledby="books" class="library">
      <div class="section-title">
        <h2 id="books">{s.books.books}</h2>
        {totalPages > 0 && <p class="meta">{s.books.pages(num(locale, totalPages))}</p>}
      </div>

      <div class="resume" data-resume-row hidden>
        <h3 class="resume__title">{s.books.reading}</h3>
        <ul class="resume__list"></ul>
      </div>

      <div class="tools" role="search">
        <label class="tools__find">
          <Icon name="search" />
          <span class="visually-hidden">{s.books.find}</span>
          <input type="search" placeholder={s.books.find} autocomplete="off" data-find />
        </label>
        {
          inMine > 0 && inMine < books.length && (
            <div class="chips" role="group">
              <button type="button" class="chip" data-only="" aria-pressed="true">
                {s.books.all}
                <span class="num">{num(locale, books.length)}</span>
              </button>
              <button type="button" class="chip" data-only="mine" aria-pressed="false">
                {s.books.inMine}
                <span class="num">{num(locale, inMine)}</span>
              </button>
            </div>
          )
        }
        <p class="meta tools__count" aria-live="polite" data-count data-template={s.books.shown('{a}', '{b}')}></p>
      </div>

      <ul class="shelf" data-shelf>
        {shelf.map((b, i) => {
          const { edition, missing, gloss } = view(b);
          const haystack = normalize(
            [
              ...Object.values(b.title),
              ...b.editions.map((e) => e.title),
              ...Object.values(b.summary ?? {}),
              ...Object.values(b.venue ?? {}),
              b.id,
            ].join(' '),
          );
          return (
            <li
              class="shelf__item"
              id={b.id}
              data-q={haystack}
              data-year={b.year}
              data-mine={missing ? undefined : ''}
            >
              <a class="shelf__link" href={page(b)}>
                <span class="shelf__stage">
                  <BookCover edition={edition} eager={i < 4} />
                  {missing && (
                    <span class="shelf__tag" title={s.books.missing(languageName(edition.lang, locale))}>
                      {languageName(edition.lang, locale)}
                    </span>
                  )}
                </span>
                <span class="shelf__progress" data-progress={edition.key} hidden>
                  <span></span>
                </span>
                <span class="shelf__text">
                  <span class="shelf__title serif align-start" lang={edition.lang} dir="auto">{edition.title}</span>
                  {gloss && <span class="gloss">{gloss}</span>}
                  <span class="meta">
                    <span class="num">{year(locale, edition.year)}</span>
                    {edition.pages && <span>{s.books.pages(num(locale, edition.pages))}</span>}
                  </span>
                  {b.editions.length > 1 && (
                    <span class="shelf__langs">
                      {b.editions.map((e) => (
                        <abbr
                          class:list={['shelf__lang', { 'is-here': e === edition }]}
                          title={languageName(e.lang, locale)}
                          lang={e.lang}
                        >
                          {LOCALE_META[e.lang].short}
                        </abbr>
                      ))}
                    </span>
                  )}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
      <p class="shelf__empty" data-empty hidden>{s.books.noMatch}</p>
    </section>
    </>
  )
}

<script
  is:inline
  type="application/json"
  id="book-shelf-data"
  set:html={JSON.stringify({
    resume: s.books.resume('{n}'),
    pct: s.books.readPct('{p}'),
    intl: LOCALE_META[locale].intl,
    // Every edition that can hold reading progress, by its progress key.
    books: Object.fromEntries(
      books.flatMap((b) => {
        const shown = view(b).edition;
        return b.editions.map((e) => [
          e.key,
          { title: e.title, lang: e.lang, cover: e.cover, href: page(b), hash: e === shown ? 'page' : `${e.lang}-page` },
        ]);
      }),
    ),
  }).replace(/</g, '\\u003c')}
/>

<script>
  import { normalize } from '../lib/search/normalize';
  import { readProgress } from '../scripts/book-progress';

  const shelf = document.querySelector<HTMLElement>('[data-shelf]');
  const raw = document.getElementById('book-shelf-data')?.textContent;
  if (shelf && raw) {
    const data = JSON.parse(raw) as {
      resume: string;
      pct: string;
      intl: string;
      books: Record<string, { title: string; lang: string; cover?: string; href: string; hash: string }>;
    };
    const fmt = new Intl.NumberFormat(data.intl);
    const n = (x: number) => fmt.format(x);
    const items = [...shelf.querySelectorAll<HTMLElement>('.shelf__item')];
    const find = document.querySelector<HTMLInputElement>('[data-find]')!;
    const count = document.querySelector<HTMLElement>('[data-count]')!;
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    let onlyMine = false;

    const apply = () => {
      const q = normalize(find.value.trim());
      const terms = q.split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const li of items) {
        const hit = terms.every((w) => li.dataset.q!.includes(w)) && (!onlyMine || li.hasAttribute('data-mine'));
        li.hidden = !hit;
        if (hit) shown++;
      }
      count.textContent = count.dataset.template!.replace('{a}', n(shown)).replace('{b}', n(items.length));
      empty.hidden = shown > 0;
    };

    find.addEventListener('input', apply);
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-only]'))
      btn.addEventListener('click', () => {
        onlyMine = btn.dataset.only === 'mine';
        for (const b of document.querySelectorAll('[data-only]')) b.setAttribute('aria-pressed', String(b === btn));
        apply();
      });
    apply();

    // Reading progress saved by the reader on this device.
    const started: { id: string; page: number; pages: number; at: number }[] = [];
    for (const id of Object.keys(data.books)) {
      const p = readProgress(id);
      if (!p) continue;
      started.push({ id, ...p });
      const bar = document.querySelector<HTMLElement>(`[data-progress="${id}"]`);
      if (bar) {
        const pct = Math.min(1, p.page / p.pages);
        bar.hidden = false;
        bar.firstElementChild!.setAttribute('style', `inline-size: ${Math.max(4, pct * 100)}%`);
        bar.title = data.pct.replace('{p}', `${n(Math.round(pct * 100))}%`);
      }
      for (const cta of document.querySelectorAll<HTMLAnchorElement>(`[data-resume="${id}"]`)) {
        cta.querySelector('span')!.textContent = data.resume.replace('{n}', n(p.page));
      }
    }
    const row = document.querySelector<HTMLElement>('[data-resume-row]');
    if (row && started.length) {
      const list = row.querySelector('ul')!;
      for (const p of started.sort((a, b) => b.at - a.at).slice(0, 4)) {
        const b = data.books[p.id];
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `${b.href}#${b.hash}=${p.page}`;
        a.className = 'resume__item';
        if (b.cover) {
          const img = document.createElement('img');
          img.src = b.cover;
          img.alt = '';
          a.append(img);
        }
        const text = document.createElement('span');
        const title = document.createElement('span');
        title.className = 'resume__name';
        title.lang = b.lang;
        title.dir = 'auto';
        title.textContent = b.title;
        const where = document.createElement('span');
        where.className = 'meta';
        where.textContent = data.resume.replace('{n}', n(p.page));
        const bar = document.createElement('span');
        bar.className = 'resume__bar';
        bar.innerHTML = `<span style="inline-size:${Math.max(4, Math.min(100, (p.page / p.pages) * 100))}%"></span>`;
        text.append(title, where, bar);
        a.append(text);
        li.append(a);
        list.append(li);
      }
      row.hidden = false;
    }
  }
</script>

<style>
  .library .section-title .meta {
    margin: 0;
  }

  /* ---------- Continue reading ---------- */
  .resume {
    margin-block-end: var(--space-6);
  }
  .resume__title {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-3);
    margin-block-end: var(--space-3);
  }
  .resume__list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-3);
  }
  .resume :global(.resume__item) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-3);
    border: 1px solid var(--rule);
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
    background: var(--paper-2);
    transition: border-color 0.15s, transform 0.2s;
  }
  .resume :global(.resume__item:hover) {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .resume :global(img) {
    width: 2.75rem;
    height: 3.5rem;
    object-fit: cover;
    border-radius: 2px;
    box-shadow: 0 4px 10px -4px rgb(0 0 0 / 0.4);
  }
  .resume :global(.resume__item > span) {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .resume :global(.resume__name) {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  :root[dir='ltr'] .resume :global(.resume__name) {
    text-align: left;
  }
  :root[dir='rtl'] .resume :global(.resume__name) {
    text-align: right;
  }
  .resume :global(.resume__bar),
  .shelf__progress {
    display: block;
    height: 3px;
    border-radius: 2px;
    background: var(--rule);
    overflow: hidden;
  }
  .resume :global(.resume__bar > span),
  .shelf__progress > span {
    display: block;
    height: 100%;
    background: var(--accent);
    border-radius: inherit;
  }

  /* ---------- Search and order ---------- */
  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-block-end: var(--space-6);
  }
  .tools__find {
    position: relative;
    flex: 1 1 16rem;
    max-width: 24rem;
  }
  .tools__find :global(svg) {
    position: absolute;
    inset-inline-start: 0.8rem;
    top: 50%;
    width: 1.05rem;
    height: 1.05rem;
    transform: translateY(-50%);
    color: var(--ink-3);
    pointer-events: none;
  }
  .tools__find input {
    width: 100%;
    padding: 0.6em 0.9em;
    padding-inline-start: 2.4rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: var(--paper);
    font-size: var(--step--1);
  }
  .tools__find input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-wash);
  }
  .tools .chip {
    background: none;
    cursor: pointer;
  }
  .tools .chip[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .tools__count {
    margin-inline-start: auto;
  }

  /* ---------- The shelf ---------- */
  .shelf {
    --cover-h: 13rem;
    --cover-w: 10.5rem;
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12.5rem), 1fr));
    gap: var(--space-7) var(--space-5);
  }
  .shelf__item[hidden] {
    display: none;
  }
  .shelf__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    text-decoration: none;
    color: inherit;
    border-radius: 4px;
    outline-offset: 6px;
  }
  /* Every book stands on the same shelf line, whatever its shape. */
  .shelf__stage {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: calc(var(--cover-h) + var(--space-5));
    padding-block-end: 10px;
  }
  .shelf__stage::after {
    content: '';
    position: absolute;
    inset-inline: -4px;
    bottom: 0;
    height: 10px;
    border-radius: 1px;
    background: linear-gradient(to bottom, var(--paper-3), var(--paper-2) 40%, var(--rule) 100%);
    box-shadow:
      0 1px 0 var(--rule-strong),
      0 10px 14px -10px rgb(0 0 0 / 0.35);
    z-index: -2;
  }
  .shelf__progress {
    margin-inline: auto;
    inline-size: 60%;
  }
  .shelf__text {
    display: grid;
    gap: 2px;
  }
  .shelf__title {
    font-size: var(--step-1);
    line-height: 1.45;
    font-weight: 600;
    transition: color 0.15s;
  }
  .shelf__link:hover .shelf__title {
    color: var(--accent);
  }
  .shelf__text .meta {
    font-size: 0.8125rem;
  }
  .shelf__empty {
    padding: var(--space-6);
    text-align: center;
    color: var(--ink-3);
    border: 1px dashed var(--rule);
    border-radius: 4px;
  }
  @media (max-width: 34rem) {
    .shelf {
      --cover-h: 10rem;
      --cover-w: 8rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6) var(--space-4);
    }
    .shelf__title {
      font-size: var(--step-0);
    }
    .tools__count {
      margin-inline-start: 0;
    }
  }
  .gloss {
    color: var(--ink-3);
    font-size: var(--step--1);
    font-style: italic;
  }
  :root[dir='rtl'] .gloss {
    font-style: normal;
  }
  /* The original's language, on books not yet translated into the reader's. */
  .shelf__tag {
    position: absolute;
    inset-block-start: var(--space-2);
    inset-inline-end: 0;
    padding: 0.1em 0.65em;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--rule-strong);
    color: var(--ink-2);
    font-size: 0.75rem;
    font-weight: 500;
    box-shadow: 0 4px 10px -6px rgb(0 0 0 / 0.4);
    z-index: 1;
  }
  .shelf__langs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-block-start: var(--space-1);
  }
  .shelf__lang {
    min-width: 1.6rem;
    padding: 0 0.35em;
    border: 1px solid var(--rule);
    border-radius: 3px;
    font-size: 0.6875rem;
    line-height: 1.5;
    text-align: center;
    text-decoration: none;
    color: var(--ink-3);
    font-family: var(--font-sans);
  }
  .shelf__lang.is-here {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-wash);
  }
</style>
