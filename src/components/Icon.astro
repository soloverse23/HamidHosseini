---
// Small, single-weight icon set (24px grid, 1.5 stroke). Brand marks are
// solid glyphs drawn to match the platforms' own marks at small sizes and
// always sit next to a text label or an aria-label.
interface Props {
  name:
    | 'telegram'
    | 'youtube'
    | 'tiktok'
    | 'instagram'
    | 'external'
    | 'arrow'
    | 'play'
    | 'search'
    | 'sun'
    | 'moon'
    | 'file'
    | 'audio'
    | 'book'
    | 'rss'
    | 'chevron'
    | 'menu'
    | 'quote'
    | 'globe'
    | 'check';
  class?: string;
  label?: string;
}
const { name, class: cls, label } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...a11y}
>
  {
    name === 'telegram' && (
      <>
        <circle cx="12" cy="12" r="10" fill="currentColor" stroke="none" />
        <path
          d="M6.2 11.7 16.4 7.8c.5-.2.9.1.8.8l-1.7 8.1c-.1.6-.5.7-1 .4l-2.7-2-1.3 1.3c-.2.1-.3.2-.5.2l.2-2.7 4.9-4.5c.2-.2 0-.3-.3-.1l-6.1 3.8-2.6-.8c-.6-.2-.6-.6.1-.9Z"
          fill="var(--icon-cut, var(--paper))"
          stroke="none"
        />
      </>
    )
  }
  {
    name === 'youtube' && (
      <path
        fill="currentColor"
        stroke="none"
        fill-rule="evenodd"
        d="M21.6 7.2a2.6 2.6 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.6 2.6 0 0 0-1.8 1.8A27 27 0 0 0 2 12a27 27 0 0 0 .4 4.8 2.6 2.6 0 0 0 1.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.6 2.6 0 0 0 1.8-1.8A27 27 0 0 0 22 12a27 27 0 0 0-.4-4.8ZM10 15.1V8.9l5.3 3.1L10 15.1Z"
      />
    )
  }
  {
    name === 'tiktok' && (
      <path
        fill="currentColor"
        stroke="none"
        d="M16.7 5.9A4.4 4.4 0 0 1 15.6 3h-3.2v12.6a2.6 2.6 0 1 1-1.8-2.5V9.9a5.8 5.8 0 1 0 5 5.7V9.3a7.5 7.5 0 0 0 4.4 1.4V7.5a4.4 4.4 0 0 1-3.3-1.6Z"
      />
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5.2" stroke-width="2" />
        <circle cx="12" cy="12" r="4.1" stroke-width="2" />
        <circle cx="17.3" cy="6.7" r="1.15" fill="currentColor" stroke="none" />
      </>
    )
  }
  {name === 'external' && <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />}
  {name === 'arrow' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === 'play' && <path d="M7 4.5v15l12-7.5z" fill="currentColor" stroke="none" />}
  {name === 'search' && (
    <>
      <circle cx="10.5" cy="10.5" r="6.5" />
      <path d="m15.5 15.5 5 5" />
    </>
  )}
  {name === 'sun' && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
    </>
  )}
  {name === 'moon' && <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />}
  {name === 'file' && <path d="M14 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V8zM14 3v5h5M9 13h6M9 17h6" />}
  {name === 'audio' && <path d="M4 10v4M8 7v10M12 4v16M16 8v8M20 11v2" />}
  {name === 'book' && <path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5zM20 5.5A1.5 1.5 0 0 0 18.5 4H13v16h5.5a1.5 1.5 0 0 0 1.5-1.5z" />}
  {name === 'rss' && <path d="M5 4a15 15 0 0 1 15 15M5 10a9 9 0 0 1 9 9M5.5 18.5h.01" />}
  {name === 'chevron' && <path d="m9 6 6 6-6 6" />}
  {
    name === 'globe' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3Z" />
      </>
    )
  }
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h10" />}
  {name === 'quote' && <path d="M10 8H6.5A1.5 1.5 0 0 0 5 9.5V13h4v-1M19 8h-3.5a1.5 1.5 0 0 0-1.5 1.5V13h4v-1M9 13c0 2-1 3.5-3 4M18 13c0 2-1 3.5-3 4" />}
</svg>
