---
// The site mark: an eight-pointed khatam drawn from two squares, with a small
// open centre. Used as logo and, small, as a section ornament.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: cls } = Astro.props;
---

<svg class={cls} width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <g stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
    <rect x="7" y="7" width="18" height="18" />
    <rect x="7" y="7" width="18" height="18" transform="rotate(45 16 16)" />
    <circle cx="16" cy="16" r="3.2" />
  </g>
</svg>
