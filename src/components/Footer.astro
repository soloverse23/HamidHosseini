---
// A colophon, as at the end of a book: the nameplate and every channel with
// its live numbers above, then the contents, languages and the fine print.
import { PROJECTS } from '../data/projects';
import { LOCALES, LOCALE_META, type Locale } from '../i18n/locales';
import { t } from '../i18n/strings';
import { ui } from '../i18n/ui';
import { lastUpdated } from '../lib/data';
import { compact, date, num } from '../lib/format';
import { href } from '../lib/paths';
import { CHANNELS } from '../lib/social';
import Icon from './Icon.astro';
import Mark from './Mark.astro';

interface Props {
  locale: Locale;
  path?: string;
  /** Locales this page exists in; the others link to their home page */
  locales?: readonly Locale[];
}
const { locale, path = '', locales = LOCALES } = Astro.props;
const switchHref = (l: Locale) => (locales.includes(l) ? href(l, path) : href(l));
const s = t(locale);
const u = ui(locale);
const pad = (i: number) => num(locale, i).padStart(2, locale === 'fa' ? '۰' : locale === 'ar' ? '٠' : '0');
// Every section, including the archives that the header folds into broader items.
const sections = [
  ['quran', s.nav.quran],
  ['topics', s.nav.topics],
  ['videos', s.nav.series],
  ['writings', s.nav.library],
  ['articles', s.nav.articles],
  ['notes', s.nav.notes],
  ['shorts', s.nav.shorts],
] as const;
// YouTube has one channel per language, so its tiles name the language instead of the handle.
const sub = (c: (typeof CHANNELS)[number]) => (c.platform === 'youtube' ? LOCALE_META[c.lang]?.label : null);
---

<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="brand">
        <a class="brand__mark" href={href(locale)} aria-label={s.name}><Mark size={40} /></a>
        <p class="f-name">{s.name}</p>
        <p class="f-tag">{s.tagline}</p>
        <p class="f-colophon">{u.colophon}</p>
        <p class="sync">
          <span class="sync__dot" aria-hidden="true"></span>
          <span>{u.synced}</span>
          <span class="sync__sep" aria-hidden="true">·</span>
          <span>
            {u.lastPost}: <time datetime={lastUpdated} data-rel>{date(locale, lastUpdated, 'short')}</time>
          </span>
        </p>
      </div>

      <div class="channels">
        <h2 class="f-head">{u.channels}</h2>
        <ul class="tiles">
          {
            CHANNELS.map((c) => (
              <li>
                <a href={c.url} rel="me noopener" target="_blank" style={`--brand:${c.brand}`} class={`tile is-${c.platform}`}>
                  <span class="tile__icon">
                    <Icon name={c.platform} />
                  </span>
                  <span class="tile__body">
                    <span class="tile__label">{c.label}</span>
                    {sub(c) ? (
                      <span class="tile__sub" lang={c.lang}>{sub(c)}</span>
                    ) : (
                      <bdi class="tile__sub tile__handle" dir="ltr">{c.handle}</bdi>
                    )}
                  </span>
                  {c.followers ? (
                    <span class="tile__n">
                      <span class="num">{compact(locale, c.followers)}</span>
                      <span class="tile__unit">{u.followers}</span>
                    </span>
                  ) : null}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="links">
      <nav class="group group--contents" aria-label={s.contents}>
        <h2 class="f-head">{s.contents}</h2>
        <ol class="f-list f-list--split">
          {
            sections.map(([key, label], i) => (
              <li>
                <a href={href(locale, key)}>
                  <span class="f-no num">{pad(i + 1)}</span>
                  {label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={href(locale, 'about')}>
              <span class="f-no" aria-hidden="true">·</span>
              {s.nav.about}
            </a>
          </li>
        </ol>
      </nav>

      <div class="group">
        <h2 class="f-head">{u.languages}</h2>
        <ul class="langs">
          {
            LOCALES.map((l) => (
              <li>
                <a href={switchHref(l)} lang={l} hreflang={l} aria-current={l === locale ? 'true' : undefined} data-set-locale={l}>
                  {LOCALE_META[l].label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="group">
        <h2 class="f-head">{s.about.projects}</h2>
        <ul class="f-list">
          {
            PROJECTS.map((p) => (
              <li>
                <a class="ext" href={p.url} rel="noopener" target="_blank">
                  {p.name[locale] ?? p.name.en}
                  <Icon name="external" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="group">
        <h2 class="f-head">{u.more}</h2>
        <ul class="f-list">
          <li><a href={href(locale, 'search')}>{s.nav.search}</a></li>
          <li><a href="/rss.xml">{u.rss}</a></li>
          <li><a href={href(locale, 'about#sources')}>{s.footer.source}</a></li>
          <li hidden data-consent-open><button type="button" class="f-link-btn">{u.consent.settings}</button></li>
        </ul>
      </div>
    </div>

    <div class="fine">
      <div class="fine__text">
        <p>{s.footer.rights}</p>
        <p>{s.quran.arabicSource}</p>
      </div>
      <a class="to-top" href="#">
        {u.toTop}
        <Icon name="arrow" />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-block-start: var(--space-8);
    background: var(--paper-2);
    border-block-start: 1px solid var(--rule);
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  /* A short accent rule at the start edge, like the head of a colophon. */
  .site-footer::before {
    content: '';
    position: absolute;
    inset-block-start: -1px;
    inset-inline-start: max(var(--gutter), calc((100% - var(--wide)) / 2));
    width: 4rem;
    height: 3px;
    background: var(--accent);
  }

  .f-head {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-block-end: var(--space-4);
  }
  :root[dir='rtl'] .f-head {
    letter-spacing: 0;
    font-size: 0.8125rem;
  }

  /* Nameplate and channels */
  .top {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-7);
  }
  @media (min-width: 62rem) {
    .top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
      gap: var(--space-7);
    }
  }
  .brand {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    max-width: 26rem;
  }
  .brand__mark {
    justify-self: start;
    color: var(--accent);
    margin-block-end: var(--space-2);
  }
  .f-name {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    color: var(--ink);
    line-height: 1.25;
  }
  :root[dir='rtl'] .f-name {
    font-weight: 700;
    line-height: 1.6;
  }
  .f-tag {
    color: var(--ink-2);
    line-height: 1.7;
  }
  .f-colophon {
    margin-block-start: var(--space-2);
    color: var(--ink-3);
    line-height: 1.8;
  }
  .sync {
    justify-self: start;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    margin-block-start: var(--space-3);
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper);
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .sync__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #3f8f5a;
    box-shadow: 0 0 0 3px color-mix(in srgb, #3f8f5a 22%, transparent);
  }
  .sync__sep {
    color: var(--rule-strong);
  }

  .tiles {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 40rem) {
    .tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .tile {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'icon body'
      'n n';
    align-items: center;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-3);
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--paper);
    text-decoration: none;
    color: var(--ink-2);
    --icon-cut: var(--paper);
    transition:
      border-color 0.15s,
      transform 0.15s,
      box-shadow 0.15s;
  }
  .tile:hover {
    border-color: color-mix(in srgb, var(--brand) 55%, var(--rule));
    transform: translateY(-2px);
    box-shadow: 0 6px 18px -10px color-mix(in srgb, var(--brand) 60%, transparent);
  }
  .tile__icon {
    grid-area: icon;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--brand) 12%, transparent);
    color: var(--brand);
  }
  .tile__icon :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }
  .is-tiktok .tile__icon {
    color: var(--brand-tiktok);
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }
  .tile__body {
    grid-area: body;
    display: grid;
    min-width: 0;
    line-height: 1.35;
  }
  .tile__label {
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    font-weight: 600;
    color: var(--ink);
  }
  .tile__sub {
    font-size: 0.8125rem;
    color: var(--ink-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tile__sub[lang='fa'],
  .tile__sub[lang='ar'],
  .tile__sub[lang='ur'] {
    font-family: var(--font-persian);
  }
  .tile__handle {
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
  }
  .tile__n {
    grid-area: n;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    padding-block-start: var(--space-2);
    border-block-start: 1px dashed var(--rule);
  }
  .tile__n .num {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--ink);
  }
  .tile__unit {
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  /* Contents, languages, projects, more */
  .links {
    display: grid;
    gap: var(--space-6) var(--space-5);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-block: var(--space-6) var(--space-7);
    border-block-start: 1px solid var(--rule);
  }
  .group--contents {
    grid-column: 1 / -1;
  }
  @media (min-width: 48rem) {
    .links {
      grid-template-columns: 2fr 1.2fr 1fr 1fr;
      gap: var(--space-6);
    }
    .group--contents {
      grid-column: auto;
    }
  }
  .f-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.2rem;
  }
  .f-list--split {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-5);
  }
  .f-list a {
    display: inline-flex;
    gap: 0.6rem;
    align-items: baseline;
    padding-block: 0.2rem;
    text-decoration: none;
    color: var(--ink-2);
    transition: color 0.15s;
  }
  .f-list .ext {
    display: inline;
  }
  .f-list .ext :global(svg) {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    margin-inline-start: 0.35rem;
    vertical-align: -0.05em;
    color: var(--ink-3);
  }
  .f-list a:hover,
  .f-link-btn:hover {
    color: var(--accent);
  }
  .f-link-btn {
    padding: 0.2rem 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--ink-2);
    cursor: pointer;
  }
  .f-no {
    font-family: var(--font-serif);
    font-size: 0.75rem;
    color: var(--ink-3);
    min-width: 1.25rem;
  }

  .langs {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .langs a {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper);
    text-decoration: none;
    color: var(--ink-2);
    font-size: 0.875rem;
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  .langs a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .langs a[aria-current='true'] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--paper);
    font-weight: 600;
  }
  .langs a[lang='fa'],
  .langs a[lang='ar'],
  .langs a[lang='ur'] {
    font-family: var(--font-persian);
  }

  .fine {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-5);
    padding-block: var(--space-5) var(--space-6);
    border-block-start: 1px solid var(--rule);
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .fine__text {
    display: grid;
    gap: var(--space-1);
    line-height: 1.7;
  }
  .to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink-2);
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  .to-top :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
    transform: rotate(-90deg);
  }
  .to-top:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .tile {
      transition: none;
    }
    .tile:hover {
      transform: none;
    }
  }
</style>
