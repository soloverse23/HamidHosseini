---
// "/" — Vercel middleware normally redirects before this page is served.
// This static fallback does the same in the browser (and for local preview).
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hamid Hosseini</title>
    <meta name="robots" content="noindex" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="ro" href="/ro/" />
    <link rel="alternate" hreflang="ar" href="/ar/" />
    <link rel="alternate" hreflang="fa" href="/fa/" />
    <script is:inline>
      (function () {
        var supported = ['en', 'ro', 'ar', 'fa'];
        var m = document.cookie.match(/(?:^|; )locale=(\w+)/);
        var pick = m && supported.indexOf(m[1]) > -1 ? m[1] : null;
        if (!pick) {
          var langs = navigator.languages || [navigator.language || 'en'];
          for (var i = 0; i < langs.length && !pick; i++) {
            var l = String(langs[i]).toLowerCase().slice(0, 2);
            if (l === 'mo') l = 'ro';
            if (supported.indexOf(l) > -1) pick = l;
          }
        }
        location.replace('/' + (pick || 'en') + '/');
      })();
    </script>
    <noscript><meta http-equiv="refresh" content="0; url=/en/" /></noscript>
  </head>
  <body>
    <p><a href="/en/">English</a> · <a href="/ro/">Română</a> · <a href="/ar/">العربية</a> · <a href="/fa/">فارسی</a></p>
  </body>
</html>
