---
// "/" — Vercel middleware normally redirects before this page is served,
// using the visitor's IP country. This static fallback mirrors that for
// local preview: saved choice first, then English (no IP geo in the browser).
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hamid Hosseini</title>
    <meta name="robots" content="noindex" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="ro" href="/ro/" />
    <link rel="alternate" hreflang="ar" href="/ar/" />
    <link rel="alternate" hreflang="fa" href="/fa/" />
    <link rel="alternate" hreflang="ur" href="/ur/" />
    <link rel="alternate" hreflang="x-default" href="/en/" />
    <script is:inline>
      (function () {
        var supported = ['en', 'ro', 'ar', 'fa', 'ur'];
        var m = document.cookie.match(/(?:^|; )locale=(\w+)/);
        var pick = m && supported.indexOf(m[1]) > -1 ? m[1] : 'en';
        location.replace('/' + pick + '/');
      })();
    </script>
    <noscript><meta http-equiv="refresh" content="0; url=/en/" /></noscript>
  </head>
  <body>
    <p><a href="/en/">English</a> · <a href="/ro/">Română</a> · <a href="/ar/">العربية</a> · <a href="/fa/">فارسی</a> · <a href="/ur/">اردو</a></p>
  </body>
</html>
