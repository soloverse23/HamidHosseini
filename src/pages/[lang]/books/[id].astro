---
// One page per book: the cover, what the book is, and the book itself, read
// in place. Each language shows its own edition when the book has been
// translated; otherwise the original, with a way to ask for a translation.
// Every other edition can be opened here too. The other books follow on a
// shelf to browse on to.
import BookCover from '../../../components/BookCover.astro';
import BookReader from '../../../components/BookReader.astro';
import Icon from '../../../components/Icon.astro';
import { LOCALES, type Locale } from '../../../i18n/locales';
import { t } from '../../../i18n/strings';
import Base from '../../../layouts/Base.astro';
import { books, editionFor, languageName, TRANSLATION_REQUESTS, type Book } from '../../../lib/books';
import { num, year } from '../../../lib/format';
import { href } from '../../../lib/paths';
import { personRef } from '../../../lib/schema';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => books.map((book) => ({ params: { lang, id: book.id }, props: { book } })));
}

const locale = Astro.params.lang as Locale;
const { book } = Astro.props as { book: Book };
const s = t(locale);
const pick = (l?: Partial<Record<Locale, string>>) => (l ? (l[locale] ?? l.en ?? Object.values(l)[0]) : undefined);
const { edition, missing } = editionFor(book, locale);
const original = book.editions[0];
const lang = (l: Locale) => languageName(l, locale);
// A reader's-language gloss of the title, when they are shown an edition in another language.
const gloss = edition.lang !== locale ? book.title[locale] : undefined;
const summary = pick(book.summary);
const venue = pick(book.venue);
const elsewhere = book.links.filter((l) => l.kind !== 'pdf' || !l.url.startsWith('/'));
const otherEditions = book.editions.filter((e) => e !== edition && e.pdf);
const others = books.filter((b) => b.id !== book.id);
const site = Astro.site!;
const path = `books/${book.id}`;
const pageUrl = new URL(href(locale, path), site).toString();
const whatsapp = `https://wa.me/${TRANSLATION_REQUESTS}?text=${encodeURIComponent(
  s.books.waText(gloss ? `${original.title} (${gloss})` : original.title, pageUrl),
)}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  '@id': `${new URL(href('en', path), site)}#book`,
  name: original.title,
  alternateName: Object.entries(book.title)
    .filter(([l]) => l !== book.lang)
    .map(([, v]) => v),
  inLanguage: book.lang,
  author: personRef(site),
  datePublished: String(book.year),
  ...(book.pages && { numberOfPages: book.pages }),
  ...(venue && { publisher: { '@type': 'Organization', name: book.venue?.en ?? venue } }),
  ...(book.cover && { image: new URL(book.cover, site).toString() }),
  ...(book.summary && { description: book.summary[book.lang] ?? book.summary.en }),
  url: pageUrl,
  ...(original.pdf && {
    workExample: {
      '@type': 'Book',
      bookFormat: 'https://schema.org/EBook',
      encodingFormat: 'application/pdf',
      url: new URL(original.pdf, site).toString(),
      inLanguage: book.lang,
    },
  }),
  ...(book.editions.length > 1 && {
    workTranslation: book.editions.slice(1).map((e) => ({
      '@type': 'Book',
      name: e.title,
      inLanguage: e.lang,
      datePublished: String(e.year),
      ...(e.pages && { numberOfPages: e.pages }),
      ...(e.translator && { translator: { '@type': 'Person', name: e.translator } }),
      ...(e.cover && { image: new URL(e.cover, site).toString() }),
      bookFormat: 'https://schema.org/EBook',
      url: new URL(e.pdf!, site).toString(),
    })),
  }),
};
const linkLabel = (kind: string, label?: string) =>
  kind === 'read' ? s.books.read : kind === 'ebook' ? s.books.ebook : kind === 'buy' ? `${s.books.buy}${label ? ` · ${label}` : ''}` : kind === 'telegram' ? s.books.file : s.books.pdf;
const hostOf = (u: string) => {
  try {
    return new URL(u).hostname.replace(/^www\./, '');
  } catch {
    return '';
  }
};
const heading = gloss ? `${edition.title} (${gloss})` : edition.title;
---

<Base
  locale={locale}
  path={path}
  title={heading}
  description={[heading, summary, venue, year(locale, edition.year), edition.pages && s.books.pages(num(locale, edition.pages))].filter(Boolean).join(' · ')}
  image={edition.cover}
  imageAlt={edition.title}
  jsonLd={jsonLd}
  crumbs={[
    { name: s.sections.writings.title, path: 'writings' },
    { name: edition.title, path },
  ]}
>
  <article class="book-page" style={`--tone: ${edition.tone}`}>
    <header class="hero">
      <div class="wrap hero__inner">
        <div class="hero__cover" data-tilt-area>
          <BookCover edition={edition} eager />
        </div>
        <div class="hero__body">
          <a class="hero__back" href={`${href(locale, 'writings')}#books`}>
            <Icon name="arrow" class="hero__back-arrow" />
            {s.books.books}
          </a>
          {
            (missing || !edition.original) && (
              <p class="hero__edition">
                <span class="hero__pill" lang={missing ? undefined : locale}>
                  {missing ? `${s.books.original} · ${lang(edition.lang)}` : s.books.translatedFrom(lang(original.lang))}
                </span>
              </p>
            )
          }
          <h1 class="serif align-start" lang={edition.lang} dir="auto">{edition.title}</h1>
          {gloss && <p class="hero__gloss">{gloss}</p>}
          {
            !edition.original && (
              <p class="hero__orig">
                <span>{s.books.originalTitle}:</span>{' '}
                <span lang={original.lang} dir="auto">{original.title}</span>
              </p>
            )
          }
          {summary && <p class="hero__summary">{summary}</p>}

          <dl class="facts">
            {venue && (
              <div>
                <dt>{s.books.publisher}</dt>
                <dd>{venue}</dd>
              </div>
            )}
            {edition.translator && (
              <div>
                <dt>{s.books.translation}</dt>
                <dd>{edition.translator}</dd>
              </div>
            )}
            <div>
              <dt>{s.books.year}</dt>
              <dd class="num">{year(locale, edition.year)}</dd>
            </div>
            {edition.pages && (
              <div>
                <dt>{s.books.pages('').trim() || s.books.reader.page}</dt>
                <dd class="num">{num(locale, edition.pages)}</dd>
              </div>
            )}
            <div>
              <dt>{s.books.language}</dt>
              <dd>{lang(edition.lang)}</dd>
            </div>
          </dl>

          <p class="btn-row hero__actions">
            {edition.pdf ? (
              <>
                <a class="btn btn--read" href={edition.pdf} data-open-reader={edition.lang}>
                  <Icon name="book" />
                  <span data-resume-label={s.books.resume('{n}')}>{s.books.start}</span>
                </a>
                <a class="btn btn--quiet" href="#read" data-open-reader={edition.lang} data-page="1" data-restart={edition.lang} hidden>
                  {s.books.start}
                </a>
                <a class="btn btn--quiet" href={edition.pdf} download>
                  <Icon name="file" />
                  {s.books.download}
                </a>
              </>
            ) : (
              elsewhere[0] && (
                <a class="btn btn--read" href={elsewhere[0].url} rel="noopener" target="_blank">
                  <Icon name="external" />
                  {linkLabel(elsewhere[0].kind, elsewhere[0].label)}
                </a>
              )
            )}
          </p>

          {
            missing && (
              <aside class="ask">
                <p class="ask__text">{s.books.missing(lang(edition.lang))}</p>
                <p class="ask__row">
                  <a class="ask__btn" href={whatsapp} rel="noopener" target="_blank">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        fill="currentColor"
                        d="M12 2.2a9.7 9.7 0 0 0-8.3 14.7L2.3 21.8l5-1.3A9.7 9.7 0 1 0 12 2.2Zm0 17.7a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 19.9Zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8.9c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.7-1.3.1-.1 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.7.3 2.8 2.8 0 0 0-.9 2.1 4.9 4.9 0 0 0 1 2.6 11.2 11.2 0 0 0 4.3 3.8c1.6.7 2.2.7 3 .6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.5-.3Z"
                      />
                    </svg>
                    {s.books.request}
                  </a>
                  <span class="ask__note">{s.books.requestNote}</span>
                </p>
              </aside>
            )
          }

          {elsewhere.length > 0 && edition.original && edition.pdf && (
            <p class="hero__elsewhere">
              <span>{s.books.elsewhere}:</span>
              {elsewhere.map((l) => (
                <a href={l.url} rel="noopener" target="_blank">
                  {hostOf(l.url) || linkLabel(l.kind, l.label)}
                  <Icon name="external" />
                </a>
              ))}
            </p>
          )}
        </div>
      </div>
    </header>

    {
      otherEditions.length > 0 && (
        <section class="wrap editions" aria-labelledby="editions">
          <h2 id="editions" class="editions__title">{s.books.editions}</h2>
          <ul class="editions__list">
            {otherEditions.map((e) => (
              <li>
                <a class="edition" href={e.pdf} data-open-reader={e.lang}>
                  <span class="edition__cover" style={`--cover-h: 6.5rem; --cover-w: 5.5rem`}>
                    <BookCover edition={e} tilt={false} />
                  </span>
                  <span class="edition__text">
                    <span class="edition__lang">
                      {lang(e.lang)}
                      {e.original && <span class="edition__tag">{s.books.original}</span>}
                    </span>
                    <span class="edition__name" lang={e.lang} dir="auto">{e.title}</span>
                    <span class="meta">
                      {e.translator && <span>{s.books.translatedBy(e.translator)}</span>}
                      {e.pages && <span>{s.books.pages(num(locale, e.pages))}</span>}
                    </span>
                  </span>
                  <span class="edition__go" aria-hidden="true"><Icon name="book" /></span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {book.editions.filter((e) => e.pdf).map((e) => <BookReader edition={e} locale={locale} main={e === edition} />)}

    {
      others.length > 0 && (
        <section class="wrap more" aria-labelledby="more">
          <div class="section-title">
            <h2 id="more">{s.books.more}</h2>
            <a href={`${href(locale, 'writings')}#books`}>{s.viewAll}</a>
          </div>
          <ul class="more__row">
            {others.map((b) => {
              const { edition: e, missing: m } = editionFor(b, locale);
              return (
                <li>
                  <a href={href(locale, `books/${b.id}`)} class="more__item">
                    <span class="more__stage">
                      <BookCover edition={e} />
                    </span>
                    <span class="more__title serif" lang={e.lang} dir="auto">
                      {e.title}
                    </span>
                    <span class="meta">
                      <span class="num">{year(locale, e.year)}</span>
                      {m ? <span>{lang(e.lang)}</span> : e.pages && <span>{s.books.pages(num(locale, e.pages))}</span>}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }
  </article>
</Base>

<style>
  .book-page {
    margin-block-start: calc(-1 * var(--space-7));
  }
  .hero {
    --cover-h: 26rem;
    --cover-w: 20rem;
    position: relative;
    isolation: isolate;
    color: #f4efe4;
    padding-block: var(--space-8);
    background:
      radial-gradient(90% 120% at 22% 10%, rgb(255 255 255 / 0.18), transparent 60%),
      radial-gradient(70% 100% at 100% 100%, rgb(0 0 0 / 0.42), transparent 70%),
      var(--tone);
    overflow: hidden;
  }
  :root[dir='rtl'] .hero {
    background:
      radial-gradient(90% 120% at 78% 10%, rgb(255 255 255 / 0.18), transparent 60%),
      radial-gradient(70% 100% at 0% 100%, rgb(0 0 0 / 0.42), transparent 70%),
      var(--tone);
  }
  /* The book's own cover, blurred, as light behind it. */
  .hero::before {
    content: '';
    position: absolute;
    inset: -10%;
    z-index: -1;
    background: radial-gradient(40% 50% at 25% 50%, rgb(255 255 255 / 0.1), transparent);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--space-7);
    align-items: center;
  }
  .hero__cover {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: calc(var(--cover-h) + var(--space-5));
  }
  .hero__body {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .hero__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--step--1);
    color: rgb(244 239 228 / 0.75);
    text-decoration: none;
  }
  .hero__back:hover {
    color: #fff;
  }
  .hero__back :global(svg) {
    width: 1em;
    height: 1em;
    transform: scaleX(-1);
  }
  :root[dir='rtl'] .hero__back :global(svg) {
    transform: none;
  }
  .hero h1 {
    font-size: clamp(2.25rem, 1.5rem + 3.4vw, 4rem);
    line-height: 1.2;
    justify-self: stretch;
  }
  .hero__gloss {
    font-size: var(--step-1);
    color: rgb(244 239 228 / 0.75);
    font-style: italic;
    margin-block-start: calc(-1 * var(--space-2));
  }
  :root[dir='rtl'] .hero__gloss {
    font-style: normal;
  }
  .hero__summary {
    font-size: var(--step-1);
    line-height: 1.65;
    max-width: 36rem;
    color: rgb(244 239 228 / 0.92);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    padding-block: var(--space-4);
    border-block: 1px solid rgb(244 239 228 / 0.2);
    justify-self: stretch;
  }
  .facts div {
    display: grid;
    gap: 2px;
  }
  .facts dt {
    font-size: 0.75rem;
    color: rgb(244 239 228 / 0.6);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  :root[dir='rtl'] .facts dt {
    letter-spacing: 0;
    text-transform: none;
    font-size: var(--step--1);
  }
  .facts dd {
    font-weight: 500;
  }
  .hero__actions {
    gap: var(--space-3);
    margin-block-start: var(--space-2);
  }
  .btn--read {
    background: #f4efe4;
    border-color: #f4efe4;
    color: #1d1a15;
    padding: 0.8em 1.6em;
    font-size: var(--step-0);
    box-shadow: 0 10px 24px -12px rgb(0 0 0 / 0.6);
  }
  .btn--read:hover {
    background: #fff;
    border-color: #fff;
    color: #1d1a15;
    transform: translateY(-1px);
  }
  .btn--quiet {
    color: #f4efe4;
    border-color: rgb(244 239 228 / 0.4);
    padding: 0.8em 1.3em;
    font-size: var(--step-0);
  }
  .btn--quiet:hover {
    color: #f4efe4;
    border-color: #f4efe4;
    background: rgb(255 255 255 / 0.08);
  }
  .hero__elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-size: var(--step--1);
    color: rgb(244 239 228 / 0.65);
  }
  .hero__elsewhere a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    color: #f4efe4;
  }
  .hero__elsewhere :global(svg) {
    width: 0.85em;
    height: 0.85em;
  }
  @media (max-width: 52rem) {
    .hero {
      --cover-h: 17rem;
      --cover-w: 13rem;
      padding-block: var(--space-6) var(--space-7);
    }
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .hero__actions {
      justify-self: stretch;
    }
    .hero__actions .btn--read {
      flex: 1 1 100%;
      justify-content: center;
    }
  }

  /* ---------- More books: one row that scrolls sideways ---------- */
  .more {
    margin-block-start: var(--space-8);
  }
  .more__row {
    --cover-h: 10rem;
    --cover-w: 8rem;
    list-style: none;
    padding: var(--space-3) 0 var(--space-4);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 10rem;
    gap: var(--space-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    overscroll-behavior-x: contain;
  }
  .more__row li {
    scroll-snap-align: start;
  }
  .more__item {
    display: grid;
    gap: var(--space-2);
    text-decoration: none;
    color: inherit;
  }
  .more__stage {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: calc(var(--cover-h) + var(--space-4));
    padding-block-end: 6px;
  }
  .more__title {
    font-weight: 600;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :root[dir='ltr'] .more__title {
    text-align: left;
  }
  :root[dir='rtl'] .more__title {
    text-align: right;
  }
  .more__item:hover .more__title {
    color: var(--accent);
  }
  .more__item .meta {
    font-size: 0.8125rem;
  }
  /* ---------- Which edition this is ---------- */
  .hero__edition {
    margin-block-end: calc(-1 * var(--space-2));
  }
  .hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.2em 0.8em;
    border-radius: 999px;
    border: 1px solid rgb(244 239 228 / 0.35);
    background: rgb(255 255 255 / 0.08);
    font-size: var(--step--1);
    color: rgb(244 239 228 / 0.9);
  }
  .hero__orig {
    font-size: var(--step--1);
    color: rgb(244 239 228 / 0.7);
    margin-block-start: calc(-1 * var(--space-2));
  }
  .hero__orig [lang] {
    color: #f4efe4;
    font-size: var(--step-0);
  }

  /* ---------- Not translated yet: ask for it ---------- */
  .ask {
    justify-self: stretch;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-radius: 6px;
    background: rgb(0 0 0 / 0.22);
    border: 1px solid rgb(244 239 228 / 0.16);
    border-inline-start: 3px solid #f4efe4;
  }
  .ask__text {
    font-size: var(--step--1);
    line-height: 1.7;
    color: rgb(244 239 228 / 0.92);
  }
  .ask__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }
  .ask__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.55em 1.1em;
    border-radius: 999px;
    background: #25d366;
    color: #06301a;
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 8px 20px -10px rgb(0 0 0 / 0.6);
    transition: transform 0.15s, background 0.15s;
  }
  .ask__btn:hover {
    background: #3ee07a;
    color: #06301a;
    transform: translateY(-1px);
  }
  .ask__btn svg {
    width: 1.15rem;
    height: 1.15rem;
  }
  .ask__note {
    font-size: 0.8125rem;
    color: rgb(244 239 228 / 0.65);
  }

  /* ---------- The same book in other languages ---------- */
  .editions {
    margin-block-start: var(--space-7);
  }
  .editions__title {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-3);
    margin-block-end: var(--space-3);
  }
  .editions__list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: var(--space-3);
  }
  .edition {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--paper-2);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.2s;
  }
  .edition:hover {
    border-color: var(--accent);
    color: inherit;
    transform: translateY(-2px);
  }
  .edition__cover {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 5.5rem;
    height: 6.75rem;
  }
  .edition__text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .edition__lang {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.04em;
  }
  .edition__tag {
    padding: 0 0.5em;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    color: var(--ink-3);
    font-weight: 500;
    letter-spacing: 0;
  }
  .edition__name {
    font-weight: 600;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :root[dir='ltr'] .edition__name {
    text-align: left;
  }
  :root[dir='rtl'] .edition__name {
    text-align: right;
  }
  .edition .meta {
    font-size: 0.8125rem;
  }
  .edition__go {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--rule);
    color: var(--ink-2);
  }
  .edition:hover .edition__go {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
