---
// One page per book: the cover, what the book is, and the book itself, read
// in place. The other books follow on a shelf to browse on to.
import BookCover from '../../../components/BookCover.astro';
import BookReader from '../../../components/BookReader.astro';
import Icon from '../../../components/Icon.astro';
import { LOCALES, LOCALE_META, type Locale } from '../../../i18n/locales';
import { t } from '../../../i18n/strings';
import Base from '../../../layouts/Base.astro';
import { books, type Book } from '../../../lib/books';
import { num, year } from '../../../lib/format';
import { href } from '../../../lib/paths';
import { personRef } from '../../../lib/schema';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => books.map((book) => ({ params: { lang, id: book.id }, props: { book } })));
}

const locale = Astro.params.lang as Locale;
const { book } = Astro.props as { book: Book };
const s = t(locale);
const pick = (l?: Partial<Record<Locale, string>>) => (l ? (l[locale] ?? l.en ?? Object.values(l)[0]) : undefined);
const original = book.title[book.lang] ?? Object.values(book.title)[0]!;
const gloss = book.lang !== locale ? book.title[locale] : undefined;
const summary = pick(book.summary);
const venue = pick(book.venue);
const elsewhere = book.links.filter((l) => l.kind !== 'pdf' || !l.url.startsWith('/'));
const others = books.filter((b) => b.id !== book.id);
const site = Astro.site!;
const path = `books/${book.id}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  '@id': new URL(href(locale, path), site).toString() + '#book',
  name: original,
  alternateName: Object.entries(book.title)
    .filter(([l]) => l !== book.lang)
    .map(([, v]) => v),
  inLanguage: book.lang,
  author: personRef(site),
  datePublished: String(book.year),
  ...(book.pages && { numberOfPages: book.pages }),
  ...(venue && { publisher: { '@type': 'Organization', name: book.venue?.en ?? venue } }),
  ...(book.cover && { image: new URL(book.cover, site).toString() }),
  ...(book.summary && { description: book.summary[book.lang] ?? book.summary.en }),
  url: new URL(href(locale, path), site).toString(),
  ...(book.pdf && {
    workExample: {
      '@type': 'Book',
      bookFormat: 'https://schema.org/EBook',
      encodingFormat: 'application/pdf',
      url: new URL(book.pdf, site).toString(),
      inLanguage: book.lang,
    },
  }),
};
const linkLabel = (kind: string, label?: string) =>
  kind === 'read' ? s.books.read : kind === 'ebook' ? s.books.ebook : kind === 'buy' ? `${s.books.buy}${label ? ` · ${label}` : ''}` : kind === 'telegram' ? s.books.file : s.books.pdf;
const hostOf = (u: string) => {
  try {
    return new URL(u).hostname.replace(/^www\./, '');
  } catch {
    return '';
  }
};
---

<Base
  locale={locale}
  path={path}
  title={gloss ? `${original} (${gloss})` : original}
  description={[gloss ? `${original} (${gloss})` : original, summary, venue, year(locale, book.year), book.pages && s.books.pages(num(locale, book.pages))].filter(Boolean).join(' · ')}
  image={book.cover}
  imageAlt={original}
  jsonLd={jsonLd}
  crumbs={[
    { name: s.sections.writings.title, path: 'writings' },
    { name: original, path },
  ]}
>
  <article class="book-page" style={`--tone: ${book.tone}`}>
    <header class="hero">
      <div class="wrap hero__inner">
        <div class="hero__cover" data-tilt-area>
          <BookCover book={book} eager />
        </div>
        <div class="hero__body">
          <a class="hero__back" href={`${href(locale, 'writings')}#books`}>
            <Icon name="arrow" class="hero__back-arrow" />
            {s.books.books}
          </a>
          <h1 class="serif align-start" lang={book.lang} dir="auto">{original}</h1>
          {gloss && <p class="hero__gloss">{gloss}</p>}
          {summary && <p class="hero__summary">{summary}</p>}

          <dl class="facts">
            {venue && (
              <div>
                <dt>{s.books.publisher}</dt>
                <dd>{venue}</dd>
              </div>
            )}
            <div>
              <dt>{s.books.year}</dt>
              <dd class="num">{year(locale, book.year)}</dd>
            </div>
            {book.pages && (
              <div>
                <dt>{s.books.pages('').trim() || s.books.reader.page}</dt>
                <dd class="num">{num(locale, book.pages)}</dd>
              </div>
            )}
            <div>
              <dt>{s.books.language}</dt>
              <dd lang={book.lang}>{LOCALE_META[book.lang].label}</dd>
            </div>
          </dl>

          <p class="btn-row hero__actions">
            {book.pdf ? (
              <>
                <a class="btn btn--read" href={`${book.pdf}`} data-open-reader>
                  <Icon name="book" />
                  <span data-resume-label={s.books.resume('{n}')}>{s.books.start}</span>
                </a>
                <a class="btn btn--quiet" href="#read" data-open-reader data-page="1" data-restart hidden>
                  {s.books.start}
                </a>
                <a class="btn btn--quiet" href={book.pdf} download>
                  <Icon name="file" />
                  {s.books.download}
                </a>
              </>
            ) : (
              elsewhere[0] && (
                <a class="btn btn--read" href={elsewhere[0].url} rel="noopener" target="_blank">
                  <Icon name="external" />
                  {linkLabel(elsewhere[0].kind, elsewhere[0].label)}
                </a>
              )
            )}
          </p>
          {book.pdf && elsewhere.length > 0 && (
            <p class="hero__elsewhere">
              <span>{s.books.elsewhere}:</span>
              {elsewhere.map((l) => (
                <a href={l.url} rel="noopener" target="_blank">
                  {hostOf(l.url) || linkLabel(l.kind, l.label)}
                  <Icon name="external" />
                </a>
              ))}
            </p>
          )}
        </div>
      </div>
    </header>

    {book.pdf && <BookReader book={book} locale={locale} />}

    {
      others.length > 0 && (
        <section class="wrap more" aria-labelledby="more">
          <div class="section-title">
            <h2 id="more">{s.books.more}</h2>
            <a href={`${href(locale, 'writings')}#books`}>{s.viewAll}</a>
          </div>
          <ul class="more__row">
            {others.map((b) => (
              <li>
                <a href={href(locale, `books/${b.id}`)} class="more__item">
                  <span class="more__stage">
                    <BookCover book={b} />
                  </span>
                  <span class="more__title serif" lang={b.lang} dir="auto">
                    {b.title[b.lang] ?? Object.values(b.title)[0]}
                  </span>
                  <span class="meta">
                    <span class="num">{year(locale, b.year)}</span>
                    {b.pages && <span>{s.books.pages(num(locale, b.pages))}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>

<style>
  .book-page {
    margin-block-start: calc(-1 * var(--space-7));
  }
  .hero {
    --cover-h: 26rem;
    --cover-w: 20rem;
    position: relative;
    isolation: isolate;
    color: #f4efe4;
    padding-block: var(--space-8);
    background:
      radial-gradient(90% 120% at 22% 10%, rgb(255 255 255 / 0.18), transparent 60%),
      radial-gradient(70% 100% at 100% 100%, rgb(0 0 0 / 0.42), transparent 70%),
      var(--tone);
    overflow: hidden;
  }
  :root[dir='rtl'] .hero {
    background:
      radial-gradient(90% 120% at 78% 10%, rgb(255 255 255 / 0.18), transparent 60%),
      radial-gradient(70% 100% at 0% 100%, rgb(0 0 0 / 0.42), transparent 70%),
      var(--tone);
  }
  /* The book's own cover, blurred, as light behind it. */
  .hero::before {
    content: '';
    position: absolute;
    inset: -10%;
    z-index: -1;
    background: radial-gradient(40% 50% at 25% 50%, rgb(255 255 255 / 0.1), transparent);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--space-7);
    align-items: center;
  }
  .hero__cover {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: calc(var(--cover-h) + var(--space-5));
  }
  .hero__body {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .hero__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--step--1);
    color: rgb(244 239 228 / 0.75);
    text-decoration: none;
  }
  .hero__back:hover {
    color: #fff;
  }
  .hero__back :global(svg) {
    width: 1em;
    height: 1em;
    transform: scaleX(-1);
  }
  :root[dir='rtl'] .hero__back :global(svg) {
    transform: none;
  }
  .hero h1 {
    font-size: clamp(2.25rem, 1.5rem + 3.4vw, 4rem);
    line-height: 1.2;
    justify-self: stretch;
  }
  .hero__gloss {
    font-size: var(--step-1);
    color: rgb(244 239 228 / 0.75);
    font-style: italic;
    margin-block-start: calc(-1 * var(--space-2));
  }
  :root[dir='rtl'] .hero__gloss {
    font-style: normal;
  }
  .hero__summary {
    font-size: var(--step-1);
    line-height: 1.65;
    max-width: 36rem;
    color: rgb(244 239 228 / 0.92);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    padding-block: var(--space-4);
    border-block: 1px solid rgb(244 239 228 / 0.2);
    justify-self: stretch;
  }
  .facts div {
    display: grid;
    gap: 2px;
  }
  .facts dt {
    font-size: 0.75rem;
    color: rgb(244 239 228 / 0.6);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  :root[dir='rtl'] .facts dt {
    letter-spacing: 0;
    text-transform: none;
    font-size: var(--step--1);
  }
  .facts dd {
    font-weight: 500;
  }
  .hero__actions {
    gap: var(--space-3);
    margin-block-start: var(--space-2);
  }
  .btn--read {
    background: #f4efe4;
    border-color: #f4efe4;
    color: #1d1a15;
    padding: 0.8em 1.6em;
    font-size: var(--step-0);
    box-shadow: 0 10px 24px -12px rgb(0 0 0 / 0.6);
  }
  .btn--read:hover {
    background: #fff;
    border-color: #fff;
    color: #1d1a15;
    transform: translateY(-1px);
  }
  .btn--quiet {
    color: #f4efe4;
    border-color: rgb(244 239 228 / 0.4);
    padding: 0.8em 1.3em;
    font-size: var(--step-0);
  }
  .btn--quiet:hover {
    color: #f4efe4;
    border-color: #f4efe4;
    background: rgb(255 255 255 / 0.08);
  }
  .hero__elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-size: var(--step--1);
    color: rgb(244 239 228 / 0.65);
  }
  .hero__elsewhere a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    color: #f4efe4;
  }
  .hero__elsewhere :global(svg) {
    width: 0.85em;
    height: 0.85em;
  }
  @media (max-width: 52rem) {
    .hero {
      --cover-h: 17rem;
      --cover-w: 13rem;
      padding-block: var(--space-6) var(--space-7);
    }
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .hero__actions {
      justify-self: stretch;
    }
    .hero__actions .btn--read {
      flex: 1 1 100%;
      justify-content: center;
    }
  }

  /* ---------- More books: one row that scrolls sideways ---------- */
  .more {
    margin-block-start: var(--space-8);
  }
  .more__row {
    --cover-h: 10rem;
    --cover-w: 8rem;
    list-style: none;
    padding: var(--space-3) 0 var(--space-4);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 10rem;
    gap: var(--space-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    overscroll-behavior-x: contain;
  }
  .more__row li {
    scroll-snap-align: start;
  }
  .more__item {
    display: grid;
    gap: var(--space-2);
    text-decoration: none;
    color: inherit;
  }
  .more__stage {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: calc(var(--cover-h) + var(--space-4));
    padding-block-end: 6px;
  }
  .more__title {
    font-weight: 600;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :root[dir='ltr'] .more__title {
    text-align: left;
  }
  :root[dir='rtl'] .more__title {
    text-align: right;
  }
  .more__item:hover .more__title {
    color: var(--accent);
  }
  .more__item .meta {
    font-size: 0.8125rem;
  }
</style>
