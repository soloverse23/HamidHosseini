---
// One question: the short answer first (what answer engines quote), then the
// full answer and its sources.
import { PROJECTS } from '../../../data/projects';
import { type Locale } from '../../../i18n/locales';
import { t } from '../../../i18n/strings';
import Base from '../../../layouts/Base.astro';
import { QUESTIONS, sourceHref, type Question } from '../../../lib/content';
import { href } from '../../../lib/paths';
import { personRef } from '../../../lib/schema';
import { excerpt } from '../../../lib/text';

export function getStaticPaths() {
  return QUESTIONS.map((q) => ({ params: { lang: q.lang, slug: q.slug }, props: { q } }));
}
const locale = Astro.params.lang as Locale;
const { q } = Astro.props as { q: Question };
const s = t(locale);
const url = new URL(href(locale, `qa/${q.slug}`), Astro.site).toString();
const muin = PROJECTS.find((p) => p.id === 'muin')!;
const paras = (q.answer ?? '').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---

<Base
  locale={locale}
  path={`qa/${q.slug}`}
  alternates={false}
  switchPath="qa"
  title={q.question}
  description={excerpt(q.short, 158)}
  ogType="article"
  published={q.date}
  crumbs={[
    { name: s.qa.title, path: 'qa' },
    { name: q.question, path: `qa/${q.slug}` },
  ]}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'QAPage',
    inLanguage: locale,
    mainEntity: {
      '@type': 'Question',
      name: q.question,
      text: q.question,
      answerCount: 1,
      ...(q.date ? { datePublished: q.date } : {}),
      author: personRef(Astro.site),
      acceptedAnswer: {
        '@type': 'Answer',
        text: [q.short, ...paras].join('\n\n'),
        url,
        author: personRef(Astro.site),
        ...(q.date ? { datePublished: q.date } : {}),
        ...(q.sources?.length ? { citation: q.sources.map((x) => new URL(sourceHref(x), Astro.site).toString()) } : {}),
      },
    },
  }}
>
  <article class="wrap answer">
    <p class="crumb meta"><a href={href(locale, 'qa')}>{s.qa.all}</a></p>
    <h1>{q.question}</h1>
    <p class="short">{q.short}</p>
    {paras.map((p) => <p>{p}</p>)}
    {
      q.sources?.length ? (
        <section>
          <h2>{s.qa.sources}</h2>
          <ul class="sources">
            {q.sources.map((x) => (
              <li>
                <a href={sourceHref(x)}>{x.label ?? x.ref}</a>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }
    <aside class="ask">
      <a class="btn" href={muin.url} rel="noopener" target="_blank">{s.qa.ask}</a>
      <p class="meta">{s.qa.askLede}</p>
    </aside>
  </article>
</Base>

<style>
  .answer {
    max-width: var(--measure);
    display: grid;
    gap: var(--space-4);
    line-height: 1.9;
  }
  .crumb a,
  .sources a {
    color: var(--accent);
  }
  h1 {
    font-size: var(--step-3);
    line-height: 1.3;
  }
  .short {
    padding: var(--space-4);
    border-inline-start: 3px solid var(--accent);
    background: var(--paper-2);
    font-size: var(--step-1);
  }
  h2 {
    font-size: var(--step-0);
  }
  .ask {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    margin-block-start: var(--space-5);
  }
</style>
