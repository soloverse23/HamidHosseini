---
import Chapter from '../../components/Chapter.astro';
import Icon from '../../components/Icon.astro';
import { type Locale } from '../../i18n/locales';
import { t } from '../../i18n/strings';
import Base from '../../layouts/Base.astro';
import { CHANNEL_URLS, instagram, notes, telegram, tiktok, youtube } from '../../lib/data';
import { compact, date, num } from '../../lib/format';
import { href, localePaths } from '../../lib/paths';
import { CHANNELS } from '../../lib/social';
import about from '../../data/content/about.json';
import { PROJECTS } from '../../data/projects';
import { excerpt } from '../../lib/text';
import { foundationNode, personId, personNode } from '../../lib/schema';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const s = t(locale);
const n = (x: number) => num(locale, x);
const c = (x?: number) => (x ? compact(locale, x) : '');
const pick = (l: Partial<Record<Locale, string>>) => l[locale] ?? l.en ?? l.fa ?? '';
const bio = pick(about.bio);

const channels = [
  { icon: 'telegram', name: telegram.profiles.main?.name ?? 'کلام', handle: '@hamidhossaini', url: CHANNEL_URLS.telegram, lang: 'fa', followers: telegram.profiles.main?.followers, items: notes.length, since: notes.at(-1)?.date, page: 'notes' },
  ...CHANNELS.filter((ch) => ch.platform === 'youtube').map((ch) => ({ icon: 'youtube' as const, name: ch.name, handle: ch.handle, url: ch.url, lang: ch.lang, followers: ch.followers, items: ch.count, since: youtube.items.filter((i) => i.channel === ch.lang).at(-1)?.date, page: 'videos' })),
  { icon: 'tiktok', name: tiktok.profiles.main?.name ?? '', handle: '@islam.de.ce.si.cum', url: CHANNEL_URLS.tiktok, lang: 'ro', followers: CHANNELS.find((ch) => ch.id === 'tiktok')?.followers, items: tiktok.items.length, since: tiktok.items.at(-1)?.date, page: 'tiktok' },
  { icon: 'instagram', name: instagram.profiles.main?.name ?? '', handle: '@kalam_hamidhosseini', url: CHANNEL_URLS.instagram, lang: 'fa', followers: instagram.profiles.main?.followers, items: instagram.items.length, since: instagram.items.at(-1)?.date, page: 'instagram' },
] as const;

const sources: Record<Locale, string[]> = {
  en: [
    'Telegram posts are read from the channel’s public web page every 30 minutes and kept here in full, including posts deleted from the preview later.',
    'YouTube videos come from the public feeds of all five channels (Persian, Romanian, Arabic, Urdu and English); episodes with the same number are paired across languages.',
    'TikTok and Instagram are read from the public profiles on the same schedule. Images are stored on this site, so they keep working when the platforms’ links expire.',
    'The Quran translation and its notes are read from the reasoned translation’s own database, and each verse links to the Telegram post where it was first proposed.',
  ],
  ro: [
    'Postările de pe Telegram sunt citite de pe pagina publică a canalului la fiecare 30 de minute și păstrate aici integral.',
    'Videoclipurile YouTube provin din fluxurile publice ale celor cinci canale (persană, română, arabă, urdu și engleză); episoadele cu același număr sunt asociate între limbi.',
    'TikTok și Instagram sunt citite din profilurile publice după același program. Imaginile sunt păstrate pe acest site, astfel încât să funcționeze și după ce linkurile platformelor expiră.',
    'Traducerea Coranului și notele ei sunt preluate din baza de date a „traducerii argumentate”, iar fiecare verset trimite la postarea de pe Telegram unde a fost propus.',
  ],
  ar: [
    'تُقرأ منشورات تيليغرام من الصفحة العامة للقناة كل 30 دقيقة وتُحفظ هنا كاملة.',
    'تأتي مقاطع يوتيوب من الخلاصات العامة للقنوات الخمس (الفارسية والرومانية والعربية والأردية والإنجليزية)، وتُقرن الحلقات ذات الرقم نفسه بين اللغات.',
    'يُقرأ تيك توك وإنستغرام من الملفات العامة بالجدول نفسه، وتُحفظ الصور في هذا الموقع كي تبقى صالحة بعد انتهاء روابط المنصات.',
    'تُقرأ ترجمة القرآن وتوضيحاتها من قاعدة بيانات «الترجمة المستدلّة» نفسها، وترتبط كل آية بمنشور تيليغرام الذي اقتُرحت فيه أول مرة.',
  ],
  fa: [
    'پست‌های تلگرام هر ۳۰ دقیقه از صفحهٔ عمومی کانال خوانده و به‌طور کامل در اینجا نگهداری می‌شوند.',
    'ویدئوهای یوتیوب از خوراک عمومی هر پنج کانال (فارسی، رومانیایی، عربی، اردو و انگلیسی) دریافت می‌شوند و قسمت‌های هم‌شماره در زبان‌های مختلف کنار هم قرار می‌گیرند.',
    'تیک‌تاک و اینستاگرام با همین برنامه از صفحه‌های عمومی خوانده می‌شوند. تصاویر روی همین سایت ذخیره می‌شوند تا پس از منقضی شدن پیوندهای پلتفرم‌ها هم در دسترس بمانند.',
    'ترجمهٔ قرآن و توضیحات آن از پایگاه دادهٔ «ترجمه مستدل قرآن» خوانده می‌شود و هر آیه به پست تلگرامی که نخستین بار در آن پیشنهاد شده پیوند دارد.',
  ],
  ur: [
    'ٹیلی گرام کی پوسٹس ہر 30 منٹ بعد چینل کے عوامی صفحے سے پڑھی جاتی ہیں اور یہاں مکمل محفوظ رہتی ہیں۔',
    'یوٹیوب ویڈیوز پانچوں چینلز (فارسی، رومانیائی، عربی، اردو اور انگریزی) کی عوامی فیڈز سے آتی ہیں؛ ایک ہی نمبر کی اقساط مختلف زبانوں میں ایک ساتھ رکھی جاتی ہیں۔',
    'ٹک ٹاک اور انسٹاگرام اسی شیڈول پر عوامی پروفائلز سے پڑھے جاتے ہیں۔ تصاویر اسی سائٹ پر محفوظ کی جاتی ہیں تاکہ پلیٹ فارمز کے روابط ختم ہونے کے بعد بھی کام کرتی رہیں۔',
    'قرآن کا ترجمہ اور اس کی وضاحتیں “مدلل ترجمہ” کے اپنے ڈیٹا بیس سے لی جاتی ہیں، اور ہر آیت اس ٹیلی گرام پوسٹ سے جڑی ہے جس میں وہ پہلی بار تجویز کی گئی۔',
  ],
};
---

<Base
  locale={locale}
  path="about"
  crumbs={[{ name: s.sections.about.title, path: 'about' }]}
  title={s.sections.about.title}
  description={excerpt(bio, 160)}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'ProfilePage', mainEntity: { '@id': personId(Astro.site) }, inLanguage: locale },
    personNode(Astro.site),
    foundationNode(Astro.site),
  ]}
>
  <div class="wrap about">
    <Chapter locale={locale} title={s.name} />

    <div class="about__grid">
      <div class="stack about__text">
        {bio.split('\n\n').map((para, i) => <p class:list={{ lede: i === 0 }}>{para}</p>)}
        <p><a href={href('fa', 'articles/2141524168')}>{s.articles.bio} →</a></p>
        <h2>{s.about.tv}</h2>
        <p>{s.about.tvText} <a href={href(locale, 'writings#ethics-of-servitude')}>{s.nav.writings} →</a></p>
      </div>

      <aside class="contact">
        <h2>{s.about.contact}</h2>
        <a class="btn" href={CHANNEL_URLS.telegramPersonal} rel="noopener" target="_blank">
          <Icon name="telegram" /> {s.about.contactTelegram} · @hamidhosseiniii
        </a>
      </aside>
    </div>

    <section class="block" id="projects" aria-labelledby="projects-title">
      <div class="section-title"><h2 id="projects-title">{s.about.projects}</h2></div>
      <ul class="projects">
        {
          PROJECTS.map((p) => (
            <li class="project">
              <h3><a href={p.url} rel="noopener" target="_blank">{pick(p.name)}</a></h3>
              <p>{pick(p.description)}</p>
              <p class="meta">
                <a href={p.url} rel="noopener" target="_blank" dir="ltr">{new URL(p.url).host}</a>
                {p.appUrl && <a href={p.appUrl} rel="noopener" target="_blank">{s.about.openApp}</a>}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block" aria-labelledby="channels">
      <div class="section-title"><h2 id="channels">{s.about.channels}</h2></div>
      <ul class="rows channels">
        {
          channels.map((ch) => (
            <li>
              <span class="ch__icon"><Icon name={ch.icon} /></span>
              <span class="ch__name">
                <a href={ch.url} rel="me noopener" target="_blank" lang={ch.lang} dir="auto">
                  {ch.name}
                </a>
                <span class="meta">{ch.handle}</span>
              </span>
              <span class="ch__num num">{c(ch.followers)}</span>
              <span class="ch__num num">
                <a href={href(locale, ch.page)}>{ch.items ? n(ch.items) : ''}</a>
              </span>
              <span class="ch__since meta">{ch.since ? date(locale, ch.since, 'month') : ''}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block measure" id="sources" aria-labelledby="sources-title">
      <div class="section-title"><h2 id="sources-title">{s.footer.source}</h2></div>
      <ul class="sources stack">
        {sources[locale].map((x) => <li>{x}</li>)}
      </ul>
      <p class="meta">{s.quran.arabicSource}</p>
    </section>
  </div>
</Base>

<style>
  .projects {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 48rem) {
    .projects {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .project {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--rule);
  }
  .project h3 {
    font-size: var(--step-1);
  }
  .project h3 a {
    color: inherit;
    text-decoration: none;
  }
  .project h3 a:hover {
    color: var(--accent);
  }
  .project .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .project .meta a {
    color: var(--accent);
  }
  .about__grid {
    display: grid;
    gap: var(--space-7);
  }
  @media (min-width: 56rem) {
    .about__grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }
  }
  .about__text {
    max-width: var(--measure);
  }
  .about__text h2,
  .contact h2 {
    font-size: var(--step-1);
    margin-block-start: var(--space-6);
  }
  .about__text a {
    color: var(--accent);
  }
  .contact {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    justify-items: start;
  }
  .contact h2 {
    margin-block-start: 0;
  }
  .block {
    margin-block-start: var(--space-8);
  }
  .channels li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr) 5rem 5rem 8rem;
    gap: var(--space-4);
    align-items: center;
    padding-block: var(--space-3);
  }
  .ch__icon :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--accent);
  }
  .ch__name {
    display: grid;
  }
  .ch__name a {
    font-weight: 500;
    text-decoration: none;
  }
  .ch__num {
    text-align: end;
  }
  .ch__num a {
    text-decoration: none;
    color: var(--accent);
  }
  .ch__since {
    text-align: end;
  }
  @media (max-width: 40rem) {
    .channels li {
      grid-template-columns: 1.5rem minmax(0, 1fr) auto auto;
    }
    .ch__since {
      display: none;
    }
  }
  .sources {
    padding-inline-start: var(--space-5);
    color: var(--ink-2);
    margin-block-end: var(--space-4);
  }
</style>
