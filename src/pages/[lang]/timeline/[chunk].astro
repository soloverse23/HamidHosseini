---
// HTML fragment for "load 10 more days" and for the "every language" switch.
// Not a full page: the home page fetches it and appends the days inside
// [data-chunk] to its timeline. "3" is a window of the reader's language,
// "all-3" the same window across every language.
import Timeline from '../../../components/Timeline.astro';
import { LOCALES, type Locale } from '../../../i18n/locales';
import { timeline, type FeedScope } from '../../../lib/feed';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => [
    ...timeline(lang)
      .slice(1)
      .map((c) => ({ params: { lang, chunk: c.slug }, props: { scope: 'own' as FeedScope, index: c.index } })),
    ...timeline(lang, 'all').map((c) => ({ params: { lang, chunk: c.slug }, props: { scope: 'all' as FeedScope, index: c.index } })),
  ]);
}

const locale = Astro.params.lang as Locale;
const { scope, index } = Astro.props as { scope: FeedScope; index: number };
const chunk = timeline(locale, scope)[index];
const next = timeline(locale, scope)[index + 1];
---

<template data-chunk={chunk.slug} data-next={next?.slug} data-next-to={next?.to}>
  <Timeline locale={locale} days={chunk.days} />
</template>
