---
// One translated verse: its own address to share, cite and find in search.
// The Arabic, the translation and every note on it, the post that proposed
// it, and everything on the site that cites it. The translation is Persian,
// so the pages exist once, under /fa/; other languages link here.
import '@fontsource/amiri-quran/400.css';
import Icon from '../../../../components/Icon.astro';
import { type Locale } from '../../../../i18n/locales';
import { t } from '../../../../i18n/strings';
import Base from '../../../../layouts/Base.astro';
import { citationsOf, type Citation } from '../../../../lib/citations';
import { arabic, noteById, quranFa, surahs } from '../../../../lib/data';
import { date, num, plain } from '../../../../lib/format';
import { href } from '../../../../lib/paths';
import { linkRoots } from '../../../../lib/glossary';
import { richNote, verseHref } from '../../../../lib/quran-refs';
import { personRef } from '../../../../lib/schema';
import { excerpt } from '../../../../lib/text';

export function getStaticPaths() {
  return Object.entries(quranFa.surahs).flatMap(([surah, ayahs]) =>
    Object.keys(ayahs).map((ayah) => ({ params: { lang: 'fa', surah, ayah } })),
  );
}

const locale = Astro.params.lang as Locale;
const s = t(locale);
const n = (x: number) => num(locale, x);
const meta = surahs[Number(Astro.params.surah) - 1];
const ayah = Number(Astro.params.ayah);
const v = quranFa.surahs[meta.n][ayah];
const ar = arabic[meta.n][ayah - 1];
const prev = ayah > 1 ? { surah: meta.n, ayah: ayah - 1 } : undefined;
const next = ayah < meta.ayahs ? { surah: meta.n, ayah: ayah + 1 } : undefined;
const title = s.quran.verseTitle(n(ayah), meta.fa);
const localPost = (id: string) => (noteById.has(id) ? href('fa', `notes/${id}`) : undefined);
const notes = (v.notes ?? []).map((x) => linkRoots(richNote(x, meta.n, localPost)));
const cited = citationsOf(meta.n, ayah);
const fromVerses = cited.filter((c) => c.kind === 'verse');
const elsewhere = cited.filter((c) => c.kind !== 'verse');
const ICON: Record<Citation['kind'], 'telegram' | 'file' | 'youtube' | 'book'> = { note: 'telegram', article: 'file', video: 'youtube', verse: 'book' };
const url = new URL(href('fa', `quran/${meta.n}/${ayah}`), Astro.site).toString();
---

<Base
  locale={locale}
  path={`quran/${meta.n}/${ayah}`}
  switchPath={`quran/${meta.n}#a${ayah}`}
  alternates={false}
  title={title}
  description={excerpt(`${meta.fa} ${n(ayah)}: ${v.text}`, 158)}
  ogType="article"
  published={v.date}
  crumbs={[
    { name: s.sections.quran.title, path: 'quran' },
    { name: `${s.quran.surah} ${meta.fa}`, path: `quran/${meta.n}` },
    { name: `${s.quran.verse} ${n(ayah)}`, path: `quran/${meta.n}/${ayah}` },
  ]}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    '@id': `${url}#translation`,
    name: title,
    headline: title,
    url,
    inLanguage: 'fa',
    text: v.text,
    ...(v.notes?.length ? { abstract: v.notes.join('\n') } : {}),
    position: ayah,
    translator: personRef(Astro.site),
    author: personRef(Astro.site),
    ...(v.date ? { datePublished: v.date } : {}),
    translationOfWork: {
      '@type': 'CreativeWork',
      name: `${meta.ar} ${ayah}`,
      text: ar,
      inLanguage: 'ar',
      isPartOf: { '@type': 'Book', name: 'القرآن الكريم', alternateName: 'The Quran' },
    },
    isPartOf: { '@type': 'Chapter', name: `${s.quran.surah} ${meta.fa}`, url: new URL(href('fa', `quran/${meta.n}`), Astro.site).toString() },
    ...(elsewhere.length
      ? { subjectOf: elsewhere.slice(0, 20).map((c) => ({ '@type': 'CreativeWork', name: c.title, url: new URL(c.href, Astro.site).toString() })) }
      : {}),
  }}
>
  <article class="wrap verse">
    <p class="crumb meta">
      <a href={href(locale, 'quran')}>{s.sections.quran.title}</a>
      <a href={href(locale, `quran/${meta.n}`)}>{n(meta.n)}. {meta.fa}</a>
      <span class="num">{n(ayah)}</span>
    </p>

    <h1>{title}</h1>

    <p class="verse__ar quran-ar" lang="ar" dir="rtl">
      {ar} <span class="ayah__end">﴿{num('ar', ayah)}﴾</span>
    </p>

    <blockquote class="verse__tr" lang="fa" dir="rtl" translate="no">
      <p>{v.text}</p>
    </blockquote>

    {
      notes.length > 0 && (
        <section class="verse__notes" aria-labelledby="notes-h">
          <h2 id="notes-h">{s.quran.notes}</h2>
          <ol>
            {notes.map((html) => (
              <li set:html={html} />
            ))}
          </ol>
        </section>
      )
    }

    <div class="verse__meta">
      {
        v.post && (
          <a href={localPost(String(v.post)) ?? `https://t.me/hamidhossaini/${v.post}`}>
            <Icon name="telegram" /> {s.quran.proposedIn} #{plain(locale, v.post)}
            {v.date && ` · ${date(locale, v.date)}`}
          </a>
        )
      }
      <button class="share" type="button" data-url={url} data-title={title} data-copied={s.quran.copied}>
        <Icon name="external" /> <span>{s.quran.share}</span>
      </button>
    </div>

    {
      elsewhere.length > 0 && (
        <section class="cited" aria-labelledby="cited-h">
          <h2 id="cited-h">{s.quran.citedIn}</h2>
          <ul>
            {elsewhere.map((c) => (
              <li>
                <Icon name={ICON[c.kind]} />
                <a href={c.href} {...(c.kind === 'video' ? { rel: 'noopener', target: '_blank' } : {})}>
                  {c.title}
                </a>
                {c.date && <span class="meta">{date(locale, c.date, 'month')}</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      fromVerses.length > 0 && (
        <section class="cited" aria-labelledby="verses-h">
          <h2 id="verses-h">{s.quran.citedByVerses}</h2>
          <p class="refs">
            {fromVerses.map((c) => (
              <a class="pill" href={c.href}>
                {surahs[c.from!.surah - 1].fa} {n(c.from!.ayah)}
              </a>
            ))}
          </p>
        </section>
      )
    }

    <nav class="verse__nav" aria-label={s.quran.wholeSurah}>
      {prev ? <a href={verseHref(prev)}><span class="meta">{s.quran.prevVerse}</span><span>{meta.fa} {n(prev.ayah)}</span></a> : <span />}
      <a class="whole" href={`${href(locale, `quran/${meta.n}`)}#a${ayah}`}>{s.quran.wholeSurah}</a>
      {next ? <a class="next" href={verseHref(next)}><span class="meta">{s.quran.nextVerse}</span><span>{meta.fa} {n(next.ayah)}</span></a> : <span />}
    </nav>
    <p class="meta source"><Icon name="book" /> {s.quran.arabicSource}</p>
  </article>
</Base>

<script>
  import { track } from '../../../../lib/analytics';

  document.querySelectorAll<HTMLButtonElement>('.share').forEach((b) =>
    b.addEventListener('click', async () => {
      const { url, title, copied } = b.dataset;
      track('verse_share', { url });
      if (navigator.share) {
        try {
          await navigator.share({ url, title });
        } catch {}
        return;
      }
      try {
        await navigator.clipboard.writeText(url!);
        b.querySelector('span')!.textContent = copied!;
      } catch {}
    }),
  );
</script>

<style>
  .verse {
    max-width: 48rem;
    display: grid;
    gap: var(--space-5);
  }
  .crumb a {
    color: var(--accent);
  }
  h1 {
    font-size: var(--step-2);
  }
  .verse__ar {
    font-family: var(--font-quran);
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    line-height: 2.1;
    text-align: start;
  }
  .ayah__end {
    color: var(--accent);
    white-space: nowrap;
  }
  .verse__tr {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    border-inline-start: 3px solid var(--accent);
    background: var(--paper-2);
    font-size: var(--step-1);
    line-height: 1.9;
  }
  .verse__notes h2,
  .cited h2 {
    font-size: var(--step-0);
    margin-block-end: var(--space-3);
  }
  .verse__notes ol {
    display: grid;
    gap: var(--space-3);
    padding-inline-start: 1.4em;
    line-height: 1.9;
  }
  .verse__notes :global(a),
  .cited a {
    color: var(--accent);
  }
  .verse__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
  .verse__meta {
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .verse__meta a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--accent);
  }
  .share {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .cited ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .cited li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }
  .refs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .verse__nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-3);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--rule);
  }
  .verse__nav a {
    display: grid;
    text-decoration: none;
    color: var(--ink);
  }
  .verse__nav .next {
    text-align: end;
  }
  .verse__nav .whole {
    color: var(--accent);
  }
</style>
