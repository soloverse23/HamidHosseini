---
import '@fontsource/amiri-quran/400.css';
import Icon from '../../../components/Icon.astro';
import { LOCALES, isRtl, type Locale } from '../../../i18n/locales';
import { t } from '../../../i18n/strings';
import Base from '../../../layouts/Base.astro';
import { arabic, noteById, quranFa, surahs, translatedCount } from '../../../lib/data';
import { personRef } from '../../../lib/schema';
import { richNote } from '../../../lib/quran-refs';
import { date, num, plain } from '../../../lib/format';
import { href } from '../../../lib/paths';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => surahs.map((m) => ({ params: { lang, surah: String(m.n) } })));
}

const locale = Astro.params.lang as Locale;
const s = t(locale);
const n = (x: number) => num(locale, x);
const meta = surahs[Number(Astro.params.surah) - 1];
const verses = arabic[meta.n];
const tr = quranFa.surahs[meta.n] ?? {};
const done = translatedCount(meta.n);
const prev = surahs[meta.n - 2];
const next = surahs[meta.n];
const localName = (m: typeof meta) => (locale === 'fa' || locale === 'ur' ? m.fa : locale === 'ar' ? m.ar : m.translit);
const subtitle = locale === 'en' ? meta.en : locale === 'ro' ? meta.translit : undefined;
const showBasmala = meta.n !== 1 && meta.n !== 9;
const title = `${s.quran.surah} ${localName(meta)}`;
const localPost = (id: string) => (noteById.has(id) ? href('fa', `notes/${id}`) : undefined);
---

<Base
  locale={locale}
  path={`quran/${meta.n}`}
  title={title}
  crumbs={[
    { name: s.sections.quran.title, path: 'quran' },
    { name: title, path: `quran/${meta.n}` },
  ]}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Chapter',
    name: `${meta.ar} · ${meta.translit}`,
    position: meta.n,
    inLanguage: ['ar', 'fa'],
    isPartOf: { '@type': 'Book', name: 'القرآن الكريم', alternateName: 'The Quran' },
    translator: personRef(Astro.site),
  }}
  description={`${title}. ${s.quran.translated(n(done), n(meta.ayahs))}`}
>
  <div class="wrap surah">
    <p class="crumb meta">
      <a href={href(locale, 'quran')}>{s.sections.quran.title}</a>
      <span class="num">{n(meta.n)} / {n(114)}</span>
    </p>

    <header class="surah__head">
      <p class="surah__ar" lang="ar" dir="rtl">سُورَةُ {meta.ar}</p>
      <h1>{title}</h1>
      <p class="meta">
        {subtitle && <span>{subtitle}</span>}
        <span>{s.quran.verses(n(meta.ayahs))}</span>
        <span>{meta.place === 'mecca' ? s.quran.mecca : s.quran.medina}</span>
        <span>{s.quran.translated(n(done), n(meta.ayahs))}</span>
      </p>
      {locale !== 'fa' && done > 0 && <p class="note-lang">{s.quran.onlyPersian}</p>}

      <div class="surah__tools">
        <form class="jump" action="#" data-base={href(locale, 'quran')}>
          <label for="jump" class="visually-hidden">{s.quran.jump}</label>
          <select id="jump">
            {surahs.map((m) => (
              <option value={m.n} selected={m.n === meta.n}>
                {n(m.n)}. {localName(m)}
              </option>
            ))}
          </select>
        </form>
        {
          done > 0 && done < meta.ayahs && (
            <label class="only">
              <input type="checkbox" id="only-translated" />
              {s.quran.translationOnly}
            </label>
          )
        }
      </div>
    </header>

    {showBasmala && <p class="basmala quran-ar" lang="ar">بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ</p>}

    <ol class="ayahs">
      {
        verses.map((text, i) => {
          const a = i + 1;
          const v = tr[a];
          return (
            <li id={`a${a}`} class:list={['ayah', { 'ayah--none': !v }]}>
              <a class="ayah__n num" href={v ? href('fa', `quran/${meta.n}/${a}`) : `#a${a}`} aria-label={`${meta.n}:${a}`}>
                {n(a)}
              </a>
              <p class="quran-ar ayah__ar" lang="ar">
                {text} <span class="ayah__end">﴿{num('ar', a)}﴾</span>
              </p>
              {v ? (
                <div class="ayah__tr" lang="fa" dir="rtl">
                  <p>{v.text}</p>
                  {v.notes && v.notes.length > 0 && (
                    <details class="ayah__notes">
                      <summary>{s.quran.notes} ({n(v.notes.length)})</summary>
                      <ul>
                        {v.notes.map((x) => (
                          <li set:html={richNote(x, meta.n, localPost)} />
                        ))}
                      </ul>
                    </details>
                  )}
                  {v.post && (
                    <a class="ayah__src meta" href={`https://t.me/hamidhossaini/${v.post}`} rel="noopener" target="_blank" dir={isRtl(locale) ? 'rtl' : 'ltr'}>
                      {s.quran.proposedIn} #{plain(locale, v.post)}{v.date && ` · ${date(locale, v.date, 'short')}`}
                    </a>
                  )}
                </div>
              ) : (
                <p class="ayah__missing meta">{s.quran.notTranslated}</p>
              )}
            </li>
          );
        })
      }
    </ol>

    <nav class="surah__nav">
      {
        prev ? (
          <a href={href(locale, `quran/${prev.n}`)}>
            <span class="meta">{s.quran.prevSurah}</span>
            <span>
              {n(prev.n)}. {localName(prev)}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={href(locale, `quran/${next.n}`)} class="next">
            <span class="meta">{s.quran.nextSurah}</span>
            <span>
              {n(next.n)}. {localName(next)}
            </span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
    <p class="meta source"><Icon name="book" /> {s.quran.arabicSource}</p>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('.jump');
  form?.querySelector('select')?.addEventListener('change', (e) => {
    location.href = `${form.dataset.base}${(e.target as HTMLSelectElement).value}/`;
  });
  const only = document.querySelector<HTMLInputElement>('#only-translated');
  only?.addEventListener('change', () => document.querySelector('.ayahs')?.classList.toggle('only-tr', only.checked));
</script>

<style>
  .surah {
    max-width: 48rem;
  }
  .crumb {
    margin-block-end: var(--space-5);
  }
  .crumb a {
    color: var(--accent);
  }
  .surah__head {
    display: grid;
    gap: var(--space-3);
    padding-block-end: var(--space-5);
    border-block-end: 1px solid var(--rule);
  }
  .surah__ar {
    font-family: var(--font-quran);
    font-size: 2rem;
    line-height: 1.6;
    color: var(--accent);
  }
  .note-lang {
    padding: var(--space-3) var(--space-4);
    border-inline-start: 2px solid var(--accent);
    background: var(--paper-2);
    color: var(--ink-2);
    font-size: var(--step--1);
  }
  .surah__tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-block-start: var(--space-2);
  }
  .jump select {
    padding: 0.4em 0.6em;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--paper);
    font-size: var(--step--1);
    max-width: 16rem;
  }
  .only {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    font-size: var(--step--1);
    color: var(--ink-2);
    cursor: pointer;
  }
  .only input {
    accent-color: var(--accent);
  }
  .basmala {
    text-align: center;
    padding-block: var(--space-5);
    color: var(--ink-2);
  }
  .ayahs {
    list-style: none;
    padding: 0;
  }
  .ayah {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-5);
    border-block-end: 1px solid var(--rule);
    scroll-margin-block-start: var(--space-5);
  }
  .ayah:target {
    background: linear-gradient(to right, var(--accent-wash), transparent 70%);
  }
  :root[dir='rtl'] .ayah:target {
    background: linear-gradient(to left, var(--accent-wash), transparent 70%);
  }
  .ayah__n {
    grid-row: span 2;
    justify-self: center;
    align-self: start;
    margin-block-start: 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-3);
    text-decoration: none;
  }
  .ayah__n:hover {
    color: var(--accent);
  }
  .ayah__ar {
    font-size: 1.65rem;
    line-height: 2.3;
  }
  .ayah__end {
    color: var(--accent);
    font-size: 0.85em;
  }
  .ayah__tr {
    display: grid;
    gap: var(--space-2);
    font-size: 1.0625rem;
    line-height: 2;
    color: var(--ink);
  }
  .ayah__notes summary {
    cursor: pointer;
    font-size: var(--step--1);
    color: var(--accent);
    width: fit-content;
  }
  .ayah__notes ul {
    margin-block-start: var(--space-2);
    padding-inline-start: var(--space-5);
    color: var(--ink-2);
    font-size: 0.9375rem;
    display: grid;
    gap: var(--space-2);
  }
  .ayah__src {
    width: fit-content;
    text-decoration: none;
  }
  .ayah__src:hover {
    color: var(--accent);
  }
  .ayah--none .ayah__ar {
    color: var(--ink-2);
  }
  .ayah__missing {
    font-style: italic;
  }
  .only-tr .ayah--none {
    display: none;
  }
  .surah__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    margin-block-start: var(--space-6);
  }
  .surah__nav a {
    display: grid;
    gap: var(--space-1);
    text-decoration: none;
  }
  .surah__nav .next {
    text-align: end;
  }
  .source {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-block-start: var(--space-6);
  }
  .source :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  @media (max-width: 30rem) {
    .ayah {
      grid-template-columns: 1.75rem 1fr;
      gap: var(--space-2);
    }
    .ayah__ar {
      font-size: 1.45rem;
    }
  }
</style>
