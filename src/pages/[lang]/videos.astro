---
import Chapter from '../../components/Chapter.astro';
import CollectionHead from '../../components/CollectionHead.astro';
import EpisodeCard from '../../components/EpisodeCard.astro';
import Icon from '../../components/Icon.astro';
import SeriesCard from '../../components/SeriesCard.astro';
import YouTubePlayer from '../../components/YouTubePlayer.astro';
import { type Locale } from '../../i18n/locales';
import { t } from '../../i18n/strings';
import Base from '../../layouts/Base.astro';
import { collectionsFor } from '../../lib/collections';
import { forReader, shorts, talksIn, type YtLang } from '../../lib/data';
import { contentLang } from '../../lib/feed';
import type { FeedItem } from '../../lib/feed-types';
import { compact, date, num } from '../../lib/format';
import { href, localePaths } from '../../lib/paths';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const s = t(locale);

const collections = collectionsFor(locale);
const featured = collections.filter((c) => c.group === 'featured');
const shelves = [
  { key: 'study', title: s.videos.studyGroup, items: collections.filter((c) => c.group === 'study') },
  { key: 'occasion', title: s.videos.occasionGroup, items: collections.filter((c) => c.group === 'occasion') },
].filter((g) => g.items.length);
// The newest upload of each of the other series, the four most recent of those.
const latest = collections
  .filter((c) => c.group !== 'featured')
  .map((c) => ({ c, ep: c.episodes[0] }))
  .sort((a, b) => b.ep.date.localeCompare(a.ep.date))
  .slice(0, 4);
const talks = talksIn(locale);
const langLabel = (v: FeedItem) => s.videos.langs[v.channel as YtLang];
const shortList: FeedItem[] = shorts.filter((v) => contentLang(v) === locale).slice(0, 18);

const iso = (sec?: number) => (sec ? `PT${Math.floor(sec / 3600) ? `${Math.floor(sec / 3600)}H` : ''}${Math.floor((sec % 3600) / 60)}M${Math.floor(sec % 60)}S` : undefined);
const videoLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: featured
    .flatMap((c) => c.episodes)
    .slice(0, 40)
    .map((ep, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'VideoObject',
        name: ep.title || `#${ep.n}`,
        description: ep.text ? ep.text.slice(0, 300) : ep.title || `#${ep.n}`,
        uploadDate: ep.date,
        inLanguage: ep.lang,
        duration: iso(ep.duration),
        thumbnailUrl: `https://i.ytimg.com/vi/${ep.id}/hqdefault.jpg`,
        embedUrl: `https://www.youtube.com/embed/${ep.id}`,
        contentUrl: ep.url,
      },
    })),
};
---

<Base locale={locale} path="videos" jsonLd={videoLd} crumbs={[{ name: s.sections.series.title, path: 'videos' }]} title={s.sections.series.title} description={s.sections.series.lede}>
  <div class="wrap">
    <Chapter locale={locale} title={s.sections.series.title} lede={s.sections.series.lede} />

    {
      featured.map((c) => (
        <section class="feature" id={c.key} aria-labelledby={`${c.key}-title`}>
          <CollectionHead locale={locale} c={c} linked />
          <div class="strip-bar">
            <h3>{s.videos.episodes}</h3>
            <a class="link-arrow" href={href(locale, c.path)}>
              {s.videos.viewSeries(num(locale, c.episodes.length))} <Icon name="arrow" class="flip" />
            </a>
          </div>
          <ul class="strip">
            {c.episodes.slice(1, 5).map((ep) => (
              <li>
                <EpisodeCard locale={locale} ep={ep} numbered={c.numbered} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    {
      latest.length > 0 && (
        <section class="block" id="latest" aria-labelledby="latest-h">
          <div class="section-title">
            <h2 id="latest-h">{s.videos.latestVideos}</h2>
          </div>
          <ul class="strip">
            {latest.map(({ c, ep }) => (
              <li>
                <EpisodeCard locale={locale} ep={ep} numbered={false} eyebrow={c.title} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      shelves.map((g) => (
        <section class="block shelf" id={g.key} aria-labelledby={`${g.key}-h`}>
          <div class="section-title">
            <h2 id={`${g.key}-h`}>{g.title}</h2>
            <span class="meta">{s.videos.episodesCount(num(locale, g.items.reduce((n, c) => n + c.episodes.length, 0)))}</span>
          </div>
          <ul class:list={['shelf__grid', g.key === 'occasion' && 'shelf__grid--small']}>
            {g.items.map((c) => (
              <li>
                <SeriesCard locale={locale} c={c} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    {
      talks.length > 0 && (
        <section aria-labelledby="other" class="block">
          <div class="section-title">
            <h2 id="other">{s.videos.other}</h2>
          </div>
          <ul class="talks">
            {talks.map((group) => {
              const [v, ...others] = forReader(group, locale);
              return (
                <li id={`v-${v.id}`}>
                  <YouTubePlayer locale={locale} id={v.id} title={v.title ?? ''} duration={v.media[0]?.duration} lang={v.lang} />
                  <p class="talks__title align-start" lang={v.lang} dir="auto" data-tr>
                    {v.title}
                  </p>
                  <p class="meta">
                    <time datetime={v.date}>{date(locale, v.date, 'short')}</time>
                    {others.length > 0 && (
                      <span class="talks__langs">
                        {others.map((o) => (
                          <a id={`v-${o.id}`} href={o.url} rel="noopener" target="_blank">
                            {langLabel(o)}
                          </a>
                        ))}
                      </span>
                    )}
                  </p>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    {
      shortList.length > 0 && (
        <section aria-labelledby="shorts" class="block">
          <div class="section-title">
            <h2 id="shorts">{s.videos.shorts}</h2>
            <a class="link-arrow" href={href(locale, 'shorts')}>
              {s.viewAll} <Icon name="arrow" class="flip" />
            </a>
          </div>
          <ul class="shorts">
            {shortList.map((v) => (
              <li id={`v-${v.id}`}>
                <YouTubePlayer locale={locale} id={v.id} title={v.title ?? ''} vertical lang={v.lang} />
                <p class="meta">
                  <time datetime={v.date}>{date(locale, v.date, 'short')}</time>
                  {v.views ? <span>{s.views(compact(locale, v.views))}</span> : null}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<script>
  // Episodes used to be anchors on this page (#ep-60); they have their own pages now.
  const old = location.hash.match(/^#ep-(\d+)$/);
  if (old) location.replace(`${location.pathname}${old[1]}/`);
</script>

<style>
  /* The featured series sits on its own panel, ahead of everything else. */
  .feature {
    padding: var(--space-6);
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: calc(var(--radius) * 3);
  }
  .feature + .feature {
    margin-block-start: var(--space-6);
  }
  .strip-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-block: var(--space-6) var(--space-4);
    padding-block-end: var(--space-2);
    border-block-end: 1px solid var(--rule-strong);
  }
  .strip-bar h3 {
    font-size: var(--step-0);
  }
  .strip {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
  }
  @media (max-width: 52rem) {
    .feature {
      padding: var(--space-4);
    }
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 34rem) {
    .strip {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
  }
  .block {
    margin-block-start: var(--space-8);
  }
  .shelf__grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-7) var(--space-5);
  }
  .shelf__grid--small {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13.5rem), 1fr));
    gap: var(--space-6) var(--space-5);
  }
  @media (max-width: 34rem) {
    .shelf__grid,
    .shelf__grid--small {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5) var(--space-3);
    }
  }

  /* ---------- Other talks and shorts ---------- */

  .talks {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-6) var(--space-5);
  }
  .talks li {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .talks__title {
    font-weight: 500;
    line-height: 1.6;
  }
  .talks__langs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
  }
  .shorts {
    list-style: none;
    padding: 0 0 var(--space-3);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 9.5rem;
    gap: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  .shorts li {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    scroll-snap-align: start;
  }
  .shorts .meta {
    font-size: 0.75rem;
  }
</style>
