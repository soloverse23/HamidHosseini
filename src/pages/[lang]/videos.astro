---
import Chapter from '../../components/Chapter.astro';
import Icon from '../../components/Icon.astro';
import YouTubePlayer from '../../components/YouTubePlayer.astro';
import { type Locale } from '../../i18n/locales';
import { t } from '../../i18n/strings';
import Base from '../../layouts/Base.astro';
import { episodesIn, forReader, shorts, talksIn, ytOrder, type YtLang } from '../../lib/data';
import { contentLang } from '../../lib/feed';
import type { FeedItem } from '../../lib/feed-types';
import { compact, date, duration, num } from '../../lib/format';
import { href, localePaths } from '../../lib/paths';
import { withoutEpisodeNo } from '../../lib/series';
import { CHANNELS } from '../../lib/social';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const s = t(locale);
const n = (x: number) => num(locale, x);

// Only episodes and talks that exist in this language — no cross-language fallback.
const episodes = episodesIn(locale);
const talks = talksIn(locale);
// The reader's own language first, then the ones they most likely also read.
const order = ytOrder(locale);
const versionsOf = (ep: (typeof episodes)[number]) => order.flatMap((k) => (ep[k] ? [ep[k]] : []));
const langLabel = (v: FeedItem) => s.videos.langs[v.channel as YtLang];

const channels = order.map((k) => CHANNELS.find((c) => c.id === `youtube-${k}`)!);
const shortList: FeedItem[] = shorts.filter((v) => contentLang(v) === locale).slice(0, 18);
const iso = (sec?: number) => (sec ? `PT${Math.floor(sec / 3600) ? `${Math.floor(sec / 3600)}H` : ''}${Math.floor((sec % 3600) / 60)}M${Math.floor(sec % 60)}S` : undefined);
const site = Astro.site!;
const videoLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: episodes.slice(0, 40).flatMap((ep, i) => {
      const v = ep[locale as YtLang];
      if (!v) return [];
      const thumb = v.media.find((m) => m.src)?.src;
      return [{
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'VideoObject',
          name: v.title ?? `#${ep.n}`,
          description: v.text ? v.text.slice(0, 300) : (v.title ?? `#${ep.n}`),
          uploadDate: v.date,
          inLanguage: v.lang ?? locale,
          duration: iso(v.media[0]?.duration),
          thumbnailUrl: thumb ? new URL(thumb, site).toString() : `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`,
          embedUrl: `https://www.youtube.com/embed/${v.id}`,
          contentUrl: v.url,
        },
      }];
    }),
};
---

<Base locale={locale} path="videos" jsonLd={videoLd} crumbs={[{ name: s.sections.videos.title, path: 'videos' }]} title={s.sections.videos.title} description={s.sections.videos.lede}>
  <div class="wrap">
    <Chapter locale={locale} no={5} title={s.sections.videos.title} lede={s.sections.videos.lede}>
      {
        channels.map((c) => (
          <a class="link-arrow" href={c.url} rel="noopener" target="_blank">
            <Icon name="youtube" />
            <span lang={c.lang} dir="auto">{c.name}</span>
            <span class="meta">
              ({s.videos.langs[c.lang]}{c.followers ? ` · ${compact(locale, c.followers)}` : ''})
            </span>
          </a>
        ))
      }
    </Chapter>

    <section aria-labelledby="eps">
      <div class="section-title">
        <h2 id="eps">{s.videos.episodes}</h2>
        <span class="meta">{s.videos.loadNote}</span>
      </div>
      <ol class="eps">
        {
          episodes.map((ep) => {
            const versions = versionsOf(ep);
            const [main] = versions;
            return (
              <li class="ep" id={`ep-${ep.n}`}>
                <span class="ep__n num" aria-hidden="true">{n(ep.n)}</span>
                <div class="ep__media">
                  <YouTubePlayer locale={locale} id={main.id} title={main.title ?? ''} duration={main.media[0]?.duration} lang={main.lang} />
                </div>
                <div class="ep__text">
                  <p class="eyebrow">
                    {s.episode(n(ep.n))} · <time datetime={ep.date}>{date(locale, ep.date, 'month')}</time>
                  </p>
                  <h3 class="serif align-start" lang={main.lang} dir="auto" data-tr><a href={href(locale, `videos/${ep.n}`)}>{withoutEpisodeNo(main.title)}</a></h3>
                  <p class="btn-row">
                    {versions.map((v) => (
                      <button class="btn" type="button" data-swap={v.id} data-title={v.title}>
                        <Icon name="play" /> {langLabel(v)}
                        {v.media[0]?.duration && <span class="meta num">{duration(v.media[0].duration)}</span>}
                      </button>
                    ))}
                    <a class="link-arrow" href={main.url} rel="noopener" target="_blank">
                      YouTube <Icon name="external" />
                    </a>
                  </p>
                </div>
              </li>
            );
          })
        }
      </ol>
    </section>

    {
      talks.length > 0 && (
        <section aria-labelledby="other" class="block">
          <div class="section-title">
            <h2 id="other">{s.videos.other}</h2>
          </div>
          <ul class="talks">
            {talks.map((group) => {
              const [v, ...others] = forReader(group, locale);
              return (
                <li id={`v-${v.id}`}>
                  <YouTubePlayer locale={locale} id={v.id} title={v.title ?? ''} duration={v.media[0]?.duration} lang={v.lang} />
                  <p class="talks__title align-start" lang={v.lang} dir="auto" data-tr>
                    {v.title}
                  </p>
                  <p class="meta">
                    <span>{langLabel(v)}</span>
                    <time datetime={v.date}>{date(locale, v.date, 'short')}</time>
                  </p>
                  {others.length > 0 && (
                    <p class="talks__langs">
                      {others.map((o) => (
                        <a class="link-arrow" id={`v-${o.id}`} href={o.url} rel="noopener" target="_blank">
                          {langLabel(o)} <Icon name="external" />
                        </a>
                      ))}
                    </p>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    {
      shortList.length > 0 && (
        <section aria-labelledby="shorts" class="block">
          <div class="section-title">
            <h2 id="shorts">{s.videos.shorts}</h2>
          </div>
          <ul class="shorts">
            {shortList.map((v) => (
              <li id={`v-${v.id}`}>
                <YouTubePlayer locale={locale} id={v.id} title={v.title ?? ''} vertical lang={v.lang} />
                <p class="meta">
                  <time datetime={v.date}>{date(locale, v.date, 'short')}</time>
                  {v.views ? <span>{s.views(compact(locale, v.views))}</span> : null}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<script>
  // Episodes used to be anchors on this page (#ep-60); they have their own pages now.
  const old = location.hash.match(/^#ep-(\d+)$/);
  if (old) location.replace(`${location.pathname}${old[1]}/`);

  document.querySelectorAll<HTMLButtonElement>('[data-swap]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const box = btn.closest('.ep')?.querySelector<HTMLElement>('.ep__media .frame');
      if (!box) return;
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.swap}?autoplay=1&rel=0`;
      f.title = btn.dataset.title ?? '';
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      f.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';
      box.replaceChildren(f);
      box.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    });
  });
</script>

<style>
  .eps {
    list-style: none;
    padding: 0;
  }
  .ep {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 20rem) minmax(0, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-block-end: 1px solid var(--rule);
    scroll-margin-block-start: var(--space-5);
    align-items: start;
  }
  .ep:target {
    background: var(--paper-2);
    box-shadow: 0 0 0 var(--space-3) var(--paper-2);
  }
  .ep__n {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    line-height: 1;
    color: var(--accent);
    text-align: end;
  }
  .ep__text {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .ep__text h3 a {
    color: inherit;
    text-decoration: none;
  }
  .ep__text h3 a:hover {
    color: var(--accent);
  }
  .ep__text h3 {
    font-size: 1.25rem;
    line-height: 1.6;
  }
  .ep__text .btn-row {
    align-items: center;
    margin-block-start: var(--space-2);
  }
  .btn .meta {
    font-size: 0.75rem;
  }
  @media (max-width: 52rem) {
    .ep {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }
    .ep__n {
      font-size: 1.75rem;
    }
    .ep__text {
      grid-column: 2;
    }
  }

  .block {
    margin-block-start: var(--space-8);
  }
  .talks {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-6) var(--space-5);
  }
  .talks li {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .talks__title {
    font-weight: 500;
    line-height: 1.6;
  }
  .talks__langs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-size: var(--step--1);
  }
  .shorts {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: var(--space-5) var(--space-3);
  }
  .shorts li {
    display: grid;
    gap: var(--space-2);
  }
  .shorts .meta {
    font-size: 0.75rem;
  }
</style>
